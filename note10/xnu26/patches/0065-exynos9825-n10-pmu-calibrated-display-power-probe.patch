+enum { N10_DISP_MAP_PMU, N10_DISP_MAP_DECON, N10_DISP_MAP_IDMA, N10_DISP_MAP_MMU, N10_DISP_MAP_PMUCAL = N10_DISP_MAP_MMU + 3,
