+static char n10_abort_name[N10_ABORT_NAMES][MAXCOMLEN + 1];
+static uint8_t n10_abort_count[N10_ABORT_NAMES];
+static uint32_t n10_abort_uuid_done;
+
+static bool
+n10_abort_note_ok(const char *comm)
+{
+	for (uint32_t i = 0; i < N10_ABORT_NAMES; i++) {
+		if (n10_abort_name[i][0] == '\0') {
+			strlcpy(n10_abort_name[i], comm, sizeof(n10_abort_name[i]));
+			n10_abort_count[i] = 1;
+			return true;
+		}
+		if (strncmp(n10_abort_name[i], comm, MAXCOMLEN) == 0) {
+			if (n10_abort_count[i] >= N10_ABORT_PER_NAME) {
+				return false;
+			}
+			n10_abort_count[i]++;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+n10_crash_messages(proc_t p, mach_vm_offset_t sc)
+{
+	static const char kinds[3] = { 'm', 's', '2' };
+	uint32_t lines = 0;
+
+	if (__atomic_exchange_n(&n10_abort_uuid_done, 1u, __ATOMIC_RELAXED) == 0) {
+		uint8_t u[16];
+		if (copyin((user_addr_t)(sc + 0x58), u, sizeof(u)) == 0) {
+			n10_dsslog_trace("N389U sc=%llx uuid=%02x%02x%02x%02x%02x%02x%02x%02x"
+			    "%02x%02x%02x%02x%02x%02x%02x%02x", (unsigned long long)sc,
+			    u[0], u[1], u[2], u[3], u[4], u[5], u[6], u[7],
+			    u[8], u[9], u[10], u[11], u[12], u[13], u[14], u[15]);
+		}
+	}
+	if (!n10_abort_note_ok(p->p_comm)) {
+		return;
+	}
+	for (uint32_t i = 0; i < sizeof(n10_crash_info_off) / sizeof(n10_crash_info_off[0]); i++) {
+		uint64_t ann[5];
+		if (copyin((user_addr_t)(sc + n10_crash_info_off[i]), ann, sizeof(ann)) != 0 ||
+		    ann[0] == 0 || ann[0] > 7) {
+			continue;
+		}
+		/* message, signature_string, message2 */
+		const uint64_t ptrs[3] = { ann[1], ann[2], ann[4] };
+		for (uint32_t k = 0; k < 3; k++) {
+			char text[241];
+			size_t done = 0;
+			int err;
+			if (ptrs[k] == 0) {
+				continue;
+			}
+			err = copyinstr((user_addr_t)ptrs[k], text, sizeof(text) - 1, &done);
+			if (err != 0 && err != ENAMETOOLONG) {
+				continue;
+			}
+			text[sizeof(text) - 1] = '\0';
+			for (char *c = text; *c != '\0'; c++) {
+				if ((unsigned char)*c < 0x20 || *c == 0x7f) {
+					*c = ' ';
+				}
+			}
+			size_t len = strlen(text);
+			for (size_t at = 0; at < len && at < 240; at += 120) {
+				if (lines++ >= N10_ABORT_LINES) {
+					return;
+				}
+				n10_dsslog_trace("N389C pid=%d i=%u %c%u %.120s", proc_getpid(p), i,
+				    kinds[k], (unsigned int)(at / 120), text + at);
+			}
+		}
+	}
+}
