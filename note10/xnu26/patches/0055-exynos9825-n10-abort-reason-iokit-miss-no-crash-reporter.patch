+/*
+ * Note10 (v389): which IOKit services userspace asks for and does not find.
+ * There are no Apple kexts; backboardd/SpringBoard abort and the missing
+ * service is not visible in their frames. One "N389I" line per distinct
+ * (process, op, matching) lookup that finds no registered service now:
+ * op g = IOServiceGetMatchingService(s), n = matching notification
+ * (publish/match; the caller waits for it). c = IOProviderClass,
+ * n = IONameMatch, r = IOResourceMatch, b = BSD Name, p = first
+ * IOPropertyMatch key[=string value], k = key count. Read-only (lookup +
+ * log), at most N10_IOKIT_MAX lines per boot, no lookup once that is spent.
+ */
+#define N10_IOKIT_MAX   96u
+#define N10_IOKIT_SEEN  128u
+static uint32_t n10_iokit_seen[N10_IOKIT_SEEN];
+static uint32_t n10_iokit_next;
+static uint32_t n10_iokit_lines;
+
+static const char *
+n10_iokit_str(OSObject *o)
+{
+	OSString *s = OSDynamicCast(OSString, o);
+	if (s == NULL) {
+		OSArray *a = OSDynamicCast(OSArray, o);
+		if (a != NULL) {
+			s = OSDynamicCast(OSString, a->getObject(0));
+		}
+	}
+	return s != NULL ? s->getCStringNoCopy() : "";
+}
+
+static uint32_t
+n10_iokit_hash(uint32_t h, const char *s)
+{
+	while (*s != '\0') {
+		h = (h ^ (uint8_t)*s++) * 16777619u;
+	}
+	return (h ^ 0xffu) * 16777619u;
+}
+
+static void
+n10_iokit_miss(char op, OSDictionary *dict, bool known_missing)
+{
+	if (__atomic_load_n(&n10_iokit_lines, __ATOMIC_RELAXED) >= N10_IOKIT_MAX) {
+		return;
+	}
+	if (!known_missing) {
+		IOService *found = IOService::copyMatchingService(dict);
+		if (found != NULL) {
+			found->release();
+			return;
+		}
+	}
+	char name[MAXCOMLEN + 1];
+	proc_selfname(name, sizeof(name));
+	const char *cls = n10_iokit_str(dict->getObject(kIOProviderClassKey));
+	const char *nm = n10_iokit_str(dict->getObject(kIONameMatchKey));
+	const char *res = n10_iokit_str(dict->getObject(kIOResourceMatchKey));
+	const char *bsd = n10_iokit_str(dict->getObject(kIOBSDNameKey));
+	const char *pk = "";
+	const char *pv = "";
+	OSDictionary *pm = OSDynamicCast(OSDictionary, dict->getObject(kIOPropertyMatchKey));
+	if (pm != NULL) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(pm);
+		if (it != NULL) {
+			const OSSymbol *key = OSDynamicCast(OSSymbol, it->getNextObject());
+			if (key != NULL) {
+				pk = key->getCStringNoCopy();
+				pv = n10_iokit_str(pm->getObject(key));
+			}
+			it->release();
+		}
+	}
+	char opstr[2] = { op, '\0' };
+	uint32_t h = 2166136261u;
+	h = n10_iokit_hash(h, name);
+	h = n10_iokit_hash(h, opstr);
+	h = n10_iokit_hash(h, cls);
+	h = n10_iokit_hash(h, nm);
+	h = n10_iokit_hash(h, res);
+	h = n10_iokit_hash(h, bsd);
+	h = n10_iokit_hash(h, pk);
+	h = n10_iokit_hash(h, pv);
+	if (h == 0) {
+		h = 1;
+	}
+	for (uint32_t i = 0; i < N10_IOKIT_SEEN; i++) {
+		if (__atomic_load_n(&n10_iokit_seen[i], __ATOMIC_RELAXED) == h) {
+			return;
+		}
+	}
+	__atomic_store_n(&n10_iokit_seen[__atomic_fetch_add(&n10_iokit_next, 1u, __ATOMIC_RELAXED) % N10_IOKIT_SEEN],
+	    h, __ATOMIC_RELAXED);
+	if (__atomic_fetch_add(&n10_iokit_lines, 1u, __ATOMIC_RELAXED) >= N10_IOKIT_MAX) {
+		return;
+	}
+	n10_dsslog_trace("N389I %s %c c=%.36s n=%.28s r=%.20s b=%.8s p=%.20s=%.12s k=%u",
+	    name, op, cls, nm, res, bsd, pk, pv, dict->getCount());
+}
