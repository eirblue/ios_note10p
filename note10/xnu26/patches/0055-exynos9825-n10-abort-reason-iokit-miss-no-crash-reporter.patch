+/*
+ * Note10 (v389): the abort reason. backboardd/SpringBoard die in
+ * std::terminate -> abort (uncaught exception); the reason is not in the
+ * frames, only in the crash-reporter annotations (crashreporter_annotations_t
+ * in __DATA,__crash_info: version, message, signature_string, backtrace,
+ * message2, ...) that CRSetCrashLogMessage() fills, e.g. CoreFoundation's
+ * "*** Terminating app due to uncaught exception ...". These are the 85
+ * iOS 16.7.16 shared-cache images that have that section, as offsets from
+ * the unslid cache base 0x180000000 (cache uuid 8f970452c9e33e88b114feb1864bc9e0,
+ * printed once as N389U so the host can confirm the match). The exiting
+ * thread is still in its own address space (as for backtrace_user above).
+ * Only the first such exit per process name is read, at most 8 lines
+ * each, so the shared trace budget is kept.
+ */
+#define N10_ABORT_NAMES         24u
+#define N10_ABORT_PER_NAME      1u
+#define N10_ABORT_LINES         8u
+static const uint32_t n10_crash_info_off[] = {
+	0x5cd315e8, 0x5cd6a3a8, 0x5cdd68a8, 0x5cde22f8, 0x5cde8d70, 0x5cdfb0b8,
