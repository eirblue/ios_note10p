+++ b/bsd/dev/n10_ufs.c
@@ -0,0 +1,671 @@
+/*
+ * Note10 (EXYNOS9825) internal UFS root device, read-only and polled.
+ *
+ * The Linux stage leaves the Exynos UFS host enabled with the link up. This
+ * driver reuses that state and never initializes PHY, UniPro, clocks or the
+ * host itself. It points the transfer request list at its own memory
+ * (verifying the host took it before ringing any doorbell) and issues one
+ * SCSI READ(10) at a time to LUN 0, slot 0, polling for completion.
+ *
+ * The controller facts are reviewed constants from the pinned Samsung
+ * sources (lineage-19.1 exynos9820 kernel 85599d66: exynos9820.dts ufs node,
+ * ufs-exynos.h, ufshci.h, ufshcd.c, exynos9820-d2s_defconfig). The boot
+ * handoff node /chosen/note10-ufs must repeat them exactly, else the driver
+ * refuses before mapping or touching any register:
+ *   hci-reg          u64 base, u64 size == 0x13d60000, 0x200 (ufs reg[0])
+ *   nexus-reg        u64 == hci base + 0x1140: vs-hci reg[1] 0x13d61100 +
+ *                    HCI_UTRL_NEXUS_TYPE 0x40
+ *   prdt-entry-size  u32 == 128: struct ufshcd_sg_entry with
+ *                    CONFIG_SCSI_UFS_EXYNOS_FMP=y (32 dwords)
+ *   prdt-length-bias u32 == 16: ufshcd_map_sg "+ 16" under
+ *                    CONFIG_SOC_EXYNOS9820=y
+ * and the one device value:
+ *   partition-lba    u64 first, u64 last: the userdata range recorded in TWRP
+ *
+ * Read-only by construction: the only SCSI opcode is READ(10); every read
+ * is clamped to the GPT header/entries while probing and to the one
+ * partition "userdata" afterwards; the driver refuses if that partition
+ * does not match partition-lba or overlaps boot, recovery, dtb, dtbo or
+ * vbmeta; write opens and writes return EROFS.
+ *
+ * Register accesses: read HCS, IS, UTRLDBR, UTRLBA, UTRLBAU, UTRLRSR and the
+ * nexus register; write IE (0), IS (acknowledge), UTRLBA, UTRLBAU, UTRLRSR,
+ * UTRLDBR (slot 0) and the nexus register (bit 0). No UIC/DME commands, no
+ * task management, no HCE, no request-list clear.
+ *
+ * DMA uses one physically contiguous allocation below 4 GiB inside the
+ * kernel-managed RAM window: descriptors plus a 256 KiB bounce buffer, with
+ * one 4 KiB PRDT entry (128-byte FMP stride) per block and the FMP crypto
+ * fields left zero. Caches
+ * are cleaned and invalidated around each command. A timed-out command
+ * disables the driver permanently.
+ *
+ * Root on it with rd=n10ufs0 (block n10ufs0, raw rn10ufs0), 512-byte
+ * logical sectors over the device's 4 KiB blocks.
+ */
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void flush_dcache64(addr64_t addr, unsigned count, int phys);
+extern unsigned long gPhysBase, gPhysSize;
+
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+
+#define SCSI_READ10     0x28
+#define SCSI_CHECK_COND 0x02
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (256u << 10)
+#define PRDT_MAX        (BOUNCE_SIZE / UFS_BLOCK)
+/* Reviewed constants (see header); handoff values must equal them. */
+#define N10_UFS_HCI_BASE        0x13d60000ull
+#define N10_UFS_HCI_SIZE        0x200ull
+#define N10_UFS_NEXUS_OFF       0x1140ull       /* vs-hci 0x1100 + HCI_UTRL_NEXUS_TYPE 0x40 */
+#define PRDT_ENTRY_SIZE         128u            /* sizeof(struct ufshcd_sg_entry) with FMP */
+#define PRDT_LENGTH_BIAS        16u             /* CONFIG_SOC_EXYNOS9820 */
+/* PRDT_SET_SIZE(12) in ufs-exynos.c: at most 4 KiB of data per PRDT entry. */
+_Static_assert(UFS_BLOCK <= (1u << 12), "PRDT entry data size exceeds the Exynos limit");
+_Static_assert(PRDT_MAX * PRDT_ENTRY_SIZE + PRDT_LENGTH_BIAS <= UINT16_MAX, "PRDT length overflows UTRD dw7");
+_Static_assert(N10_UFS_NEXUS_OFF >= N10_UFS_HCI_SIZE && N10_UFS_NEXUS_OFF + 4 <= 0x2000,
+    "nexus register outside the UFS HCI block");
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+
+/* Layout of the contiguous DMA allocation (UCD offsets are byte granular). */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define UCD_RESP        512u
+#define UCD_PRDT        1024u
+#define DMA_BOUNCE      0x8000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+_Static_assert(DMA_UCD + UCD_PRDT + PRDT_MAX * PRDT_ENTRY_SIZE <= DMA_BOUNCE, "UCD overlaps the bounce buffer");
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, bytes */
+	uint32_t prdt;          /* [31:16] PRDT offset, [15:0] PRDT length, bytes */
+};
+
+static const char n10_ufs_part[] = "userdata";
+static const char *const n10_ufs_gated[] = { "boot", "recovery", "dtb", "dtbo", "vbmeta" };
+
+static struct {
+	vm_offset_t regs, nexus;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint64_t want_first, want_last;         /* partition-lba from the handoff */
+	uint64_t lo, hi;                        /* readable device-block window, inclusive */
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	uint8_t tag;
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready, dead;
+} nu;
+
+static LCK_GRP_DECLARE(n10_ufs_grp, "n10_ufs");
+static LCK_MTX_DECLARE(n10_ufs_lock, &n10_ufs_grp);
+
+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(nu.dma_pa + off), len, TRUE);
+}
+
+static uint64_t
+le(const uint8_t *p, unsigned bytes)
+{
+	uint64_t v = 0;
+	for (unsigned i = 0; i < bytes; i++) {
+		v |= (uint64_t)p[i] << (8 * i);
+	}
+	return v;
+}
+
+/* One READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+n10_ufs_read_once(uint64_t lba, uint32_t count)
+{
+	struct utrd *utrd = (struct utrd *)(nu.dma + DMA_UTRL);
+	uint8_t *ucd = (uint8_t *)(nu.dma + DMA_UCD);
+	uint64_t ucd_pa = nu.dma_pa + DMA_UCD, bounce_pa = nu.dma_pa + DMA_BOUNCE;
+	uint32_t len = count * UFS_BLOCK;
+
+	/* Strides and length are reviewed constants; re-check before any DMA. */
+	if (count == 0 || count > PRDT_MAX || UCD_PRDT + count * PRDT_ENTRY_SIZE > DMA_BOUNCE - DMA_UCD) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		SCSI_READ10, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, UCD_PRDT + PRDT_MAX * PRDT_ENTRY_SIZE);
+
+	ucd[0] = 0x01;                          /* COMMAND UPIU */
+	ucd[1] = 0x40;                          /* R: data in */
+	ucd[2] = 0;                             /* LUN 0 */
+	ucd[3] = ++nu.tag;
+	ucd[12] = (uint8_t)(len >> 24);
+	ucd[13] = (uint8_t)(len >> 16);
+	ucd[14] = (uint8_t)(len >> 8);
+	ucd[15] = (uint8_t)len;
+	memcpy(&ucd[16], cdb, sizeof(cdb));
+
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t *e = (uint32_t *)(ucd + UCD_PRDT + i * PRDT_ENTRY_SIZE);
+		uint64_t pa = bounce_pa + (uint64_t)i * UFS_BLOCK;
+		e[0] = (uint32_t)pa;
+		e[1] = (uint32_t)(pa >> 32);
+		e[2] = 0;
+		e[3] = UFS_BLOCK - 1;           /* data byte count, zero based */
+	}
+
+	utrd->dw0 = (1u << 28) | (2u << 25);    /* UFS storage command, device to host */
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (UCD_RESP << 16) | UCD_RESP;
+	utrd->prdt = (UCD_PRDT << 16) | (count * PRDT_ENTRY_SIZE + PRDT_LENGTH_BIAS);
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, UCD_PRDT + PRDT_MAX * PRDT_ENTRY_SIZE);
+	dma_sync(DMA_BOUNCE, len);
+	__builtin_arm_dsb(0xf);
+
+	uint32_t nexus = rd32(nu.nexus, 0);
+	if (!(nexus & 1)) {
+		wr32(nu.nexus, 0, nexus | 1);   /* slot 0 carries a SCSI command */
+	}
+	wr32(nu.regs, REG_UTRLDBR, 1);
+
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (rd32(nu.regs, REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			nu.dead = true;
+			printf("Note10 UFS: READ at block 0x%llx timed out; driver disabled\n", lba);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	wr32(nu.regs, REG_IS, rd32(nu.regs, REG_IS));   /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, UCD_PRDT);
+	dma_sync(DMA_BOUNCE, len);
+
+	uint32_t ocs = utrd->dw2 & 0x0f;
+	uint8_t const *resp = ucd + UCD_RESP;
+	if (ocs || resp[0] != 0x21 || resp[6] || resp[7]) {
+		printf("Note10 UFS: READ failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    ocs, resp[0], resp[6], resp[7]);
+		return (!ocs && resp[0] == 0x21 && !resp[6] && resp[7] == SCSI_CHECK_COND) ? EAGAIN : EIO;
+	}
+	return 0;
+}
+
+/* Clamped read: only blocks inside the current window [lo, hi]. */
+static int
+n10_ufs_read(uint64_t lba, uint32_t count)
+{
+	if (nu.dead) {
+		return EIO;
+	}
+	if (count == 0 || count > PRDT_MAX || lba > UINT32_MAX - count ||
+	    lba < nu.lo || lba + count - 1 > nu.hi) {
+		return EINVAL;
+	}
+	if (nu.dma_pa < gPhysBase || nu.dma_pa + DMA_SIZE > (uint64_t)gPhysBase + gPhysSize ||
+	    nu.dma_pa + DMA_SIZE > (1ull << 32)) {
+		return EIO;
+	}
+	int error = EIO;
+	/* A command after the Linux stage may first report a unit attention. */
+	for (int i = 0; i < 3; i++) {
+		error = n10_ufs_read_once(lba, count);
+		if (error != EAGAIN) {
+			break;
+		}
+	}
+	return error;
+}
+
+static bool
+n10_ufs_overlap(uint64_t a0, uint64_t a1, uint64_t b0, uint64_t b1)
+{
+	return a0 <= b1 && b0 <= a1;
+}
+
+static void
+n10_ufs_entry_name(const uint8_t *e, char name[37])
+{
+	unsigned c;
+	for (c = 0; c < 36; c++) {
+		uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+		if (ch == 0 || ch > 0x7f) {
+			break;
+		}
+		name[c] = (char)ch;
+	}
+	name[c] = 0;
+}
+
+static int
+n10_ufs_find_partition(void)
+{
+	const uint8_t *b = (const uint8_t *)(nu.dma + DMA_BOUNCE);
+	int error;
+
+	nu.lo = nu.hi = 1;
+	if ((error = n10_ufs_read(1, 1))) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0 || le(b + 24, 8) != 1) {
+		printf("Note10 UFS: LUN 0 has no GPT at 4 KiB block 1\n");
+		return ENXIO;
+	}
+	uint64_t entry_lba = le(b + 72, 8);
+	uint32_t nent = (uint32_t)le(b + 80, 4), esz = (uint32_t)le(b + 84, 4);
+	if (esz != 128 || nent == 0 || nent > BOUNCE_SIZE / esz || entry_lba < 2 || entry_lba > UINT32_MAX) {
+		printf("Note10 UFS: unsupported GPT entries %u x %u at %llu\n", nent, esz, entry_lba);
+		return ENXIO;
+	}
+	uint32_t eblocks = (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK;
+	nu.lo = entry_lba;
+	nu.hi = entry_lba + eblocks - 1;
+	if ((error = n10_ufs_read(entry_lba, eblocks))) {
+		return error;
+	}
+
+	uint64_t first = 0, last = 0;
+	unsigned found = 0;
+	for (uint32_t i = 0; i < nent; i++) {
+		char name[37];
+		n10_ufs_entry_name(b + i * esz, name);
+		if (strcmp(name, n10_ufs_part) == 0) {
+			first = le(b + i * esz + 32, 8);
+			last = le(b + i * esz + 40, 8);
+			found++;
+		}
+	}
+	if (found != 1 || last < first || first <= nu.hi || last > UINT32_MAX) {
+		printf("Note10 UFS: need exactly one valid \"%s\" (found %u)\n", n10_ufs_part, found);
+		return ENOENT;
+	}
+	if (first != nu.want_first || last != nu.want_last) {
+		printf("Note10 UFS: \"%s\" 0x%llx-0x%llx differs from the handoff\n", n10_ufs_part, first, last);
+		return EPERM;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		char name[37];
+		n10_ufs_entry_name(b + i * esz, name);
+		for (unsigned g = 0; g < sizeof(n10_ufs_gated) / sizeof(n10_ufs_gated[0]); g++) {
+			if (strcmp(name, n10_ufs_gated[g]) == 0 &&
+			    n10_ufs_overlap(first, last, le(b + i * esz + 32, 8), le(b + i * esz + 40, 8))) {
+				printf("Note10 UFS: \"%s\" overlaps \"%s\"; refused\n", n10_ufs_part, name);
+				return EPERM;
+			}
+		}
+	}
+	nu.first_block = first;
+	nu.nblocks = last - first + 1;
+	nu.lo = first;
+	nu.hi = last;
+	return 0;
+}
+
+static int
+n10_ufs_take_over_host(void)
+{
+	uint32_t hcs = rd32(nu.regs, REG_HCS);
+	if (!(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("Note10 UFS: host not ready (hcs 0x%x)\n", hcs);
+		return ENXIO;
+	}
+	if (rd32(nu.regs, REG_UTRLDBR)) {
+		printf("Note10 UFS: requests outstanding from the Linux stage\n");
+		return EBUSY;
+	}
+	wr32(nu.regs, REG_IE, 0);                       /* polled operation */
+	wr32(nu.regs, REG_IS, rd32(nu.regs, REG_IS));
+	wr32(nu.regs, REG_UTRLRSR, 0);
+	uint64_t list = nu.dma_pa + DMA_UTRL;
+	wr32(nu.regs, REG_UTRLBA, (uint32_t)list);
+	wr32(nu.regs, REG_UTRLBAU, (uint32_t)(list >> 32));
+	wr32(nu.regs, REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (rd32(nu.regs, REG_UTRLBA) != (uint32_t)list || rd32(nu.regs, REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(rd32(nu.regs, REG_UTRLRSR) & 1)) {
+		printf("Note10 UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+n10_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!nu.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+n10_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+n10_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * nu.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = nu.nblocks * UFS_BLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&n10_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = n10_ufs_read(nu.first_block + lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(nu.dma + DMA_BOUNCE + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&n10_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+n10_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = nu.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		nu.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = nu.nblocks * UFS_BLOCK / nu.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / nu.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+n10_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return n10_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+n10_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return n10_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+n10_ufs_psize(__unused dev_t dev)
+{
+	return nu.ready ? (int)MIN(nu.nblocks * UFS_BLOCK / nu.secsize, INT_MAX) : -1;
+}
+
+static int
+n10_ufs_rdwr(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(n10_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)nu.secsize);
+}
+
+static int
+n10_ufs_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw n10_ufs_bdevsw = {
+	.d_open     = n10_ufs_open,
+	.d_close    = n10_ufs_close,
+	.d_strategy = n10_ufs_strategy,
+	.d_ioctl    = n10_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = n10_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw n10_ufs_cdevsw = {
+	.d_open       = n10_ufs_open,
+	.d_close      = n10_ufs_close,
+	.d_read       = n10_ufs_rdwr,
+	.d_write      = n10_ufs_write,
+	.d_ioctl      = n10_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static const uint8_t *
+n10_ufs_prop(DTEntry node, const char *name, unsigned int expected)
+{
+	void const *value = NULL;
+	unsigned int size = 0;
+	if (SecureDTGetProperty(node, name, &value, &size) != kSuccess || size != expected || !value) {
+		printf("Note10 UFS: handoff property %s missing or malformed\n", name);
+		return NULL;
+	}
+	return value;
+}
+
+static int
+n10_ufs_handoff(void)
+{
+	DTEntry node;
+	const uint8_t *hci, *nexus, *esz, *bias, *part;
+
+	if (SecureDTLookupEntry(NULL, "/chosen/note10-ufs", &node) != kSuccess) {
+		printf("Note10 UFS: no /chosen/note10-ufs handoff node\n");
+		return ENXIO;
+	}
+	if (!(hci = n10_ufs_prop(node, "hci-reg", 16)) || !(nexus = n10_ufs_prop(node, "nexus-reg", 8)) ||
+	    !(esz = n10_ufs_prop(node, "prdt-entry-size", 4)) || !(bias = n10_ufs_prop(node, "prdt-length-bias", 4)) ||
+	    !(part = n10_ufs_prop(node, "partition-lba", 16))) {
+		return ENXIO;
+	}
+	uint64_t hci_base = le(hci, 8), hci_size = le(hci + 8, 8), nexus_pa = le(nexus, 8);
+	uint32_t prdt_esz = (uint32_t)le(esz, 4), prdt_bias = (uint32_t)le(bias, 4);
+	nu.want_first = le(part, 8);
+	nu.want_last = le(part + 8, 8);
+	/* Assert the handoff against the reviewed constants before any mapping. */
+	if (hci_base != N10_UFS_HCI_BASE || hci_size != N10_UFS_HCI_SIZE ||
+	    nexus_pa != hci_base + N10_UFS_NEXUS_OFF ||
+	    prdt_esz != PRDT_ENTRY_SIZE || prdt_bias != PRDT_LENGTH_BIAS ||
+	    nu.want_first == 0 || nu.want_last < nu.want_first) {
+		printf("Note10 UFS: handoff differs from the reviewed controller constants\n");
+		return ENXIO;
+	}
+	nu.regs = ml_io_map((vm_offset_t)hci_base, (vm_size_t)hci_size);
+	vm_offset_t nexus_page = ml_io_map((vm_offset_t)trunc_page_64(nexus_pa), PAGE_SIZE);
+	if (!nu.regs || !nexus_page) {
+		return ENXIO;
+	}
+	nu.nexus = nexus_page + (vm_offset_t)(nexus_pa & PAGE_MASK);
+	return 0;
+}
+
+static int
+n10_ufs_init(void)
+{
+	int error;
+
+	if (nu.dead) {
+		return EIO;
+	}
+	if ((error = n10_ufs_handoff())) {
+		return error;
+	}
+	if (kmem_alloc_contig(kernel_map, &nu.dma, DMA_SIZE, PAGE_MASK,
+	    (ppnum_t)(((1ull << 32) >> PAGE_SHIFT) - 1), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("Note10 UFS: no contiguous DMA memory below 4 GiB\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)nu.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	nu.dma_pa = ptoa_64(pn);
+	nu.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&n10_ufs_lock);
+	error = n10_ufs_take_over_host();
+	if (!error) {
+		error = n10_ufs_find_partition();
+	}
+	lck_mtx_unlock(&n10_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	nu.bmajor = bdevsw_add(-1, &n10_ufs_bdevsw);
+	if (nu.bmajor < 0) {
+		return ENXIO;
+	}
+	nu.cmajor = cdevsw_add_with_bdev(-1, &n10_ufs_cdevsw, nu.bmajor);
+	if (nu.cmajor < 0) {
+		return ENXIO;
+	}
+	nu.bdev = makedev(nu.bmajor, 0);
+	devfs_make_node(nu.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "n10ufs0");
+	devfs_make_node(makedev(nu.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rn10ufs0");
+	nu.ready = true;
+	printf("Note10 UFS: \"%s\" on LUN 0: first block 0x%llx, %llu MiB, read-only\n",
+	    n10_ufs_part, nu.first_block, nu.nblocks * UFS_BLOCK >> 20);
+	return 0;
+}
+
+/* Root device for rd=n10ufs0 (IOFindBSDRoot). */
+int n10_ufs_rootdev(dev_t *dev);
+
+int
+n10_ufs_rootdev(dev_t *dev)
+{
+	if (!nu.ready) {
+		int error = n10_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = nu.bdev;
+	return 0;
+}
