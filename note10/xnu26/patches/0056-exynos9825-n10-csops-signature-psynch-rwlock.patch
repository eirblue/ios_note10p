+static void
+n10_ps_rw_trace(proc_t p, const char *op, user_addr_t rwlock, uint32_t a, uint32_t b, uint32_t c)
+{
+	if (__atomic_fetch_add(&n10_ps_rw_lines, 1u, __ATOMIC_RELAXED) < N10_PS_RW_LINES) {
+		n10_dsslog_trace("N390R %s pid=%d %s lock=0x%llx 0x%x 0x%x 0x%x", op, proc_getpid(p), p->p_comm,
+		    (unsigned long long)rwlock, a, b, c);
+	}
+}
+
+static void
+n10_ps_rw_note(struct n10_ps_obj *o, uint32_t lgen)
+{
+	if (!o->rw_seen || n10_ps_le(o->rw_max, lgen)) {
+		o->rw_max = lgen & N10_PS_COUNT;
+		o->rw_seen = true;
+	}
+}
+
+static struct n10_ps_waiter *
+n10_ps_rw_find(struct n10_ps_obj *o, uint32_t ord)
+{
+	struct n10_ps_waiter *w;
+
+	TAILQ_FOREACH(w, &o->waiters, link) {
+		if (w->ord == ord) {
+			return w;
+		}
+	}
+	return NULL;
+}
+
+/* Make the pending grant if its first ordinal is in the kernel. Lock held. */
+static void
+n10_ps_rw_grant(proc_t p, user_addr_t rwlock, struct n10_ps_obj *o)
+{
+	uint32_t first = (o->rw_next + N10_PS_INC) & N10_PS_COUNT, last = first, n = 1, bits;
+	struct n10_ps_waiter *w;
+
+	if (o->credits == 0 || (w = n10_ps_rw_find(o, first)) == NULL) {
+		return;
+	}
+	if (w->type == N10_PS_READ) {
+		while (n10_ps_pending(o->rw_max, last) != 0 &&
+		    (w = n10_ps_rw_find(o, (last + N10_PS_INC) & N10_PS_COUNT)) != NULL && w->type == N10_PS_READ) {
+			last = w->ord;
+			n++;
+		}
+		bits = n10_ps_pending(o->rw_max, last) != 0 ? (N10_PS_RW_K | N10_PS_RW_W) : 0;
+	} else {
+		bits = N10_PS_RW_K | N10_PS_RW_E | (n10_ps_pending(o->rw_max, last) != 0 ? N10_PS_RW_W : 0);
+	}
+	bits |= n * N10_PS_INC;
+	for (uint32_t k = 0; k < n; k++) {
+		w = n10_ps_rw_find(o, (first + k * N10_PS_INC) & N10_PS_COUNT);
+		w->bits = bits;
+		n10_ps_wake(o, w);
+	}
+	o->credits = 0;
+	n10_ps_rw_trace(p, "grant", rwlock, first, n, bits);
+}
+
+int
+n10_psynch_rw_lock(proc_t p, user_addr_t rwlock, uint32_t lgenval, uint32_t ugenval, uint32_t type,
+    uint32_t *retval)
+{
+	struct n10_ps_waiter w = { .ord = lgenval & N10_PS_COUNT, .type = type };
+	struct n10_ps_obj *o;
+	int error = 0;
+
+	lck_mtx_lock(&n10_ps_lock);
+	o = n10_ps_lookup(p, rwlock, N10_PS_RW, true);
+	n10_ps_rw_note(o, lgenval);
+	TAILQ_INSERT_TAIL(&o->waiters, &w, link);
+	n10_ps_rw_grant(p, rwlock, o);
+	if (!w.released) {
+		TAILQ_REMOVE(&o->waiters, &w, link);
+		error = n10_ps_sleep(o, &w, 0);
+	}
+	n10_ps_release(o);
+	lck_mtx_unlock(&n10_ps_lock);
+	if (error == 0) {
+		*retval = w.bits;
+	} else {
+		n10_ps_rw_trace(p, type == N10_PS_READ ? "rd-err" : "wr-err", rwlock, lgenval, ugenval, (uint32_t)error);
+	}
+	return error;
+}
+
+int
+n10_psynch_rw_unlock(proc_t p, user_addr_t rwlock, uint32_t lgenval, uint32_t ugenval, uint32_t rw_wc,
+    uint32_t *retval)
+{
+	struct n10_ps_obj *o;
+
+	lck_mtx_lock(&n10_ps_lock);
+	o = n10_ps_lookup(p, rwlock, N10_PS_RW, true);
+	n10_ps_rw_note(o, lgenval);
+	if (o->credits != 0 || ((ugenval ^ rw_wc) & N10_PS_COUNT) != 0) {
+		n10_ps_rw_trace(p, "unlock?", rwlock, lgenval, ugenval, rw_wc);
+	}
+	o->rw_next = rw_wc & N10_PS_COUNT;
+	o->credits = 1;
+	n10_ps_rw_grant(p, rwlock, o);
+	n10_ps_release(o);
+	lck_mtx_unlock(&n10_ps_lock);
+	*retval = 0;
+	return 0;
+}
