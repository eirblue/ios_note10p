+static uint32_t n10_csops_lines;
+#define N10_CSOPS_LINES 64u
+
+/*
+ * Note10 (v390): AMFI is not loaded and CS_SIGNED/CS_VALID are never set on
+ * this port, so every entitlement and identity query of csops failed with
+ * EINVAL (v389: BSSelfTaskHasEntitlement("com.apple.springboard-ui.client")
+ * false in SpringBoard -> SpringBoardUI assertion; containermanagerd refused
+ * backboardd's system container -> nil path -> NSURL exception). Answer them
+ * from the target's own embedded signature: the entitlements blob
+ * (CSSLOT_ENTITLEMENTS XML, CSSLOT_DER_ENTITLEMENTS DER) and the code
+ * directory identifier / team id, as IOTaskHasEntitlement does (v341).
+ * Read only; MACF get_cs_info has already been checked by the caller.
+ */
+static int
+n10_csops_signature(proc_t pt, int ops, user_size_t usize, user_addr_t uaddr)
+{
+	struct cs_blob *blob = NULL;
+	const CS_GenericBlob *gb = NULL;
+	const char *identity = NULL;
+	uint8_t fakeheader[8] = { 0 };
+	uint32_t idlen;
+	size_t length = 0;
+	int error;
+
+	proc_lock(pt);
+	if (pt->p_textvp != NULLVP) {
+		blob = ubc_cs_blob_get(pt->p_textvp, -1, -1, pt->p_textoff);
+	}
+	proc_unlock(pt);
+
+	if (blob == NULL) {
+		error = EBADEXEC;
+	} else if (ops == CS_OPS_ENTITLEMENTS_BLOB || ops == CS_OPS_DER_ENTITLEMENTS_BLOB) {
+		gb = (ops == CS_OPS_DER_ENTITLEMENTS_BLOB) ?
+		    csblob_find_blob(blob, CSSLOT_DER_ENTITLEMENTS, CSMAGIC_EMBEDDED_DER_ENTITLEMENTS) :
+		    csblob_find_blob(blob, CSSLOT_ENTITLEMENTS, CSMAGIC_EMBEDDED_ENTITLEMENTS);
+		length = gb != NULL ? ntohl(gb->length) : 0;
+		/* no entitlements blob: zero header */
+		error = csops_copy_token(gb, length, usize, uaddr);
+	} else {
+		identity = (ops == CS_OPS_TEAMID) ? csblob_get_teamid(blob) : csblob_get_identity(blob);
+		if (usize < sizeof(fakeheader)) {
+			error = ERANGE;
+		} else if (identity == NULL) {
+			error = ENOENT;
+		} else {
+			length = strlen(identity) + 1;         /* include NUL */
+			idlen = htonl((uint32_t)(length + sizeof(fakeheader)));
+			memcpy(&fakeheader[4], &idlen, sizeof(idlen));
+			error = copyout(fakeheader, uaddr, sizeof(fakeheader));
+			if (error == 0 && usize < sizeof(fakeheader) + length) {
+				error = ERANGE;
+			} else if (error == 0) {
+				error = copyout(identity, uaddr + sizeof(fakeheader), length);
+			}
+		}
+	}
+
+	if (__atomic_fetch_add(&n10_csops_lines, 1u, __ATOMIC_RELAXED) < N10_CSOPS_LINES) {
+		n10_dsslog_trace("N390S %s op=%d pid=%d %s len=%u err=%d", current_proc()->p_comm, ops,
+		    proc_getpid(pt), pt->p_comm, (unsigned int)length, error);
+	}
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_EXYNOS9825 */
