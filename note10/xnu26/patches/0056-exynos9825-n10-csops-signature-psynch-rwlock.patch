+	uint32_t                credits;        /* wakeups not delivered to a sleeper; rw: grant pending */
+	uint32_t                rw_next;        /* rw: S count the pending grant follows */
+	uint32_t                rw_max;         /* rw: highest L count seen */
+	bool                    rw_seen;
 };
 
