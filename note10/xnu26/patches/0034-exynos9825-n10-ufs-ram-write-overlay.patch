 	bool ready;
 } nu;
 
+/* v368 RAM write overlay: open-addressed table, key = partition block + 1 (0 = empty). */
+#define N10_UFS_RAM_BLOCKS      32768u          /* 128 MiB of written blocks at most */
+#define N10_UFS_RAM_SLOTS       (2 * N10_UFS_RAM_BLOCKS)
+static struct {
+	uint32_t key;
+	void *page;
+} *n10_ufs_ram;
+static uint32_t n10_ufs_ram_used;
+
 static LCK_GRP_DECLARE(n10_ufs_grp, "n10_ufs");
