 	n10_ufs_stop(13, 0x80u | (((const uint8_t *)(nu.dma + DMA_UCD + UCD_RESP))[36] & 0x0fu));
 }
 
+/*
+ * v368: RAM page of partition block blk, or NULL. With create, a missing page
+ * is allocated and filled from the UFS (READ(10)); NULL when the overlay is full.
+ * Caller holds n10_ufs_lock.
+ */
+static void *
+n10_ufs_ram_page(uint64_t blk, bool create)
+{
+	uint32_t key = (uint32_t)blk + 1;
+	uint32_t i = (key * 2654435761u) & (N10_UFS_RAM_SLOTS - 1);
+
+	while (n10_ufs_ram[i].key) {
+		if (n10_ufs_ram[i].key == key) {
+			return n10_ufs_ram[i].page;
+		}
+		i = (i + 1) & (N10_UFS_RAM_SLOTS - 1);
+	}
+	if (!create) {
+		return NULL;
+	}
+	if (n10_ufs_ram_used >= N10_UFS_RAM_BLOCKS) {
+		return NULL;
+	}
+	void *page = kalloc_data(UFS_BLOCK, Z_WAITOK | Z_NOFAIL);
+	n10_ufs_read(nu.first_block + blk, 1);
+	memcpy(page, (const void *)(nu.dma + DMA_BOUNCE), UFS_BLOCK);
+	n10_ufs_ram[i].key = key;
+	n10_ufs_ram[i].page = page;
+	if (n10_ufs_ram_used++ % 8192 == 0) {
+		printf("Note10 UFS: RAM overlay %u/%u blocks (block 0x%llx)\n",
+		    n10_ufs_ram_used, N10_UFS_RAM_BLOCKS, blk);
+	}
+	return page;
+}
