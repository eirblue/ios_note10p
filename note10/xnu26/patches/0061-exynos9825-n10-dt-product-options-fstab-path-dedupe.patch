diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index 2900125..aa82fc9 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -2860,18 +2860,40 @@ n10_open_fail(IOService *service, uint32_t type, IOReturn res)
  * HAL audio plug-ins read IODeviceTree:/product/audio): one "N394P" line
  * with the caller, the MIG variant (o = 0 inband, 1 out-of-line) and the
  * path, at most N10_PATH_MAX lines per boot. Log only, result unchanged.
+ * v395: cap 48 -> 128; a (caller, path) pair already logged is skipped
+ * (FNV-1a hash of the caller name and the first 100 path bytes; a race
+ * between two first misses of the same pair may log it twice).
  */
-#define N10_PATH_MAX    48u
+#define N10_PATH_MAX    128u
 static uint32_t n10_path_lines;
+static uint32_t n10_path_seen[N10_PATH_MAX];
 
 static void
 n10_path_miss(const char *path, uint32_t ool)
 {
-	if (__atomic_fetch_add(&n10_path_lines, 1u, __ATOMIC_RELAXED) >= N10_PATH_MAX) {
-		return;
-	}
 	char name[MAXCOMLEN + 1];
+	uint32_t h = 2166136261u, i, n;
+
 	proc_selfname(name, sizeof(name));
+	for (i = 0; name[i] != 0; i++) {
+		h = (h ^ (uint8_t)name[i]) * 16777619u;
+	}
+	h = (h ^ 0xffu) * 16777619u;
+	for (i = 0; i < 100 && path[i] != 0; i++) {
+		h = (h ^ (uint8_t)path[i]) * 16777619u;
+	}
+	h |= 1u;                        /* 0 = free slot */
+	n = __atomic_load_n(&n10_path_lines, __ATOMIC_RELAXED);
+	for (i = 0; i < n && i < N10_PATH_MAX; i++) {
+		if (__atomic_load_n(&n10_path_seen[i], __ATOMIC_RELAXED) == h) {
+			return;
+		}
+	}
+	n = __atomic_fetch_add(&n10_path_lines, 1u, __ATOMIC_RELAXED);
+	if (n >= N10_PATH_MAX) {
+		return;
+	}
+	__atomic_store_n(&n10_path_seen[n], h, __ATOMIC_RELAXED);
 	n10_dsslog_trace("N394P %s o=%u p=%.100s", name, ool, path);
 }
 #endif /* ARM64_BOARD_CONFIG_EXYNOS9825 */
