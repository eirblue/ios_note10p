 n10_iomfb_publish(void)
@@ -351,6 +565,7 @@ n10_iomfb_publish(void)
 	bool disp = false, fb_ok = false;
 	IORegistryEntry *armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
 
+	n10_dt_publish();
 	if (armio != NULL) {
 		armio_state = 1;
 	} else {
