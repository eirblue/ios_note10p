+#define N10_DT_NODES    16u
+
+static void
+n10_dt_publish(void)
+{
+	IORegistryEntry *nodes[N10_DT_NODES];
+	bool made[N10_DT_NODES];
+	unsigned int n = 1, cur = 0, created = 0, props = 0;
+	const char *p = n10_dt_blob;
+
+	nodes[0] = IORegistryEntry::fromPath("/", gIODTPlane);
+	made[0] = false;
+	while (nodes[0] != NULL && *p != 0) {
+		unsigned int b = (uint8_t)*p++;
+		const char *name = p;
+
+		p += strlen(name) + 1;
+		if (b >= 0xf0u) {
+			if (n >= N10_DT_NODES || b - 0xf0u >= n) {
+				break;
+			}
+			IORegistryEntry *parent = nodes[b - 0xf0u];
+			IORegistryEntry *node = parent != NULL ? parent->childFromPath(name, gIODTPlane) : NULL;
+			made[n] = false;
+			if (node == NULL && parent != NULL) {
+				node = n10_fb_dt_node(parent, name, NULL);
+				made[n] = node != NULL;
+				created += made[n];
+			}
+			nodes[n] = node;
+			cur = n++;
+			continue;
+		}
+		if (made[cur]) {
+			OSData *d = OSData::withBytes(p, b - 1u);
+			if (d != NULL) {
+				props += nodes[cur]->setProperty(name, d);
+				d->release();
+			}
+		}
+		p += b - 1u;
+	}
+	for (unsigned int i = 0; i < n; i++) {
+		OSSafeReleaseNULL(nodes[i]);
+	}
+	n10_dsslog_trace("N395D publish nodes=%u created=%u props=%u", n - 1, created, props);
+}
+
+/*
+ * Called once from IOKitBSDInit: the v395 device-tree entries, the
+ * display-subsystem node under IODeviceTree:/arm-io (arm-io itself only when
+ * the boot device tree has none), then the IOMobileFramebuffer service on
+ * IOResources.
  */
