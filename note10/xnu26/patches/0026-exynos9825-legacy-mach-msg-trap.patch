--- a/osfmk/ipc/ipc_policy.c
+++ b/osfmk/ipc/ipc_policy.c
@@ -384,6 +384,11 @@ ipc_policy_allow_legacy_mach_msg_trap_for_platform(
 			return false;
 		}
 		break;
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
