+/* IOUserClient.cpp is_io_object_conforms_to (v404): the touch service answers "IOHIDEventService". */
+extern "C" bool n10_touch_conforms(OSObject *object, const char *name);
+
+extern "C" bool
+n10_touch_conforms(OSObject *object, const char *name)
+{
+	return object != NULL && n10_ts_svc != NULL && object == n10_ts_svc &&
+	       strncmp(name, "IOHIDEventService", sizeof("IOHIDEventService")) == 0;
+}
+
+static void
+n10_ts_publish(IOService *resources)
+{
+	bool ok = false;
+	IOService *svc = OSTypeAlloc(IOService);
+	OSArray *pairs = OSArray::withCapacity(1);
+	OSDictionary *pair = OSDictionary::withCapacity(2);
+	OSNumber *page = OSNumber::withNumber(0x0dull, 32), *usage = OSNumber::withNumber(0x04ull, 32);
+
+	n10_ts_lock = IOLockAlloc();
+	n10_ts_q = IOSharedDataQueue::withCapacity(N10_TS_QUEUE);
+	if (n10_ts_lock != NULL && n10_ts_q != NULL && svc != NULL && pairs != NULL && pair != NULL && page != NULL &&
+	    usage != NULL && resources != NULL && svc->init() && svc->attach(resources)) {
+		pair->setObject("DeviceUsagePage", page);
+		pair->setObject("DeviceUsage", usage);
+		pairs->setObject(pair);
+		svc->setName("NoteTouchHIDEventService");
+		svc->setProperty("HIDServiceSupport", true);
+		svc->setProperty("PrimaryUsagePage", 0x0du, 32);
+		svc->setProperty("PrimaryUsage", 0x04u, 32);
+		svc->setProperty("DeviceUsagePairs", pairs);
+		svc->setProperty("Built-In", true);
+		svc->setProperty("DisplayIntegrated", true);
+		svc->setProperty("Transport", "I2C");
+		svc->setProperty("Product", "Note10 Touch");
+		svc->setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+		ok = svc->start(resources);
+		if (ok) {
+			n10_ts_svc = svc;
+			svc->registerService();
+		} else {
+			svc->detach(resources);
+		}
+	}
+	OSSafeReleaseNULL(svc);
+	OSSafeReleaseNULL(pairs);
+	OSSafeReleaseNULL(pair);
+	OSSafeReleaseNULL(page);
+	OSSafeReleaseNULL(usage);
+	if (ok) {
+		n10_ts_tmr = thread_call_allocate_with_priority(n10_ts_tick, NULL, THREAD_CALL_PRIORITY_KERNEL);
+		if (n10_ts_tmr != NULL) {
+			uint64_t d;
+			nanoseconds_to_absolutetime(N10_TS_FIRST_NS, &d);
+			thread_call_enter_delayed(n10_ts_tmr, mach_absolute_time() + d);
+		}
+	}
+	n10_dsslog_trace("N404H publish hid=%u regid=0x%llx q=%u tmr=%u", ok ? 1u : 0u,
+	    (unsigned long long)(ok ? n10_ts_svc->getRegistryEntryID() : 0), n10_ts_q != NULL ? 1u : 0u,
+	    n10_ts_tmr != NULL ? 1u : 0u);
+}
