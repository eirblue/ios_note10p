+/*
+ * v404 touch (see the header). Public SoC / board facts: exynos9820 device
+ * tree hsi2c@104B0000 + touchscreen@48, Linux i2c-exynos5.c register map,
+ * sec_ts y771_d command set and 16-byte coordinate event.
+ */
+#define N10_TS_I2C_PA           0x104b0000u
+#define N10_TS_I2C_SIZE         0x1000u
+#define N10_TS_GPA1_PA          0x15850000u     /* pinctrl@15850000: GPA1 DAT +0x24 bit 0 (ATTN, low = pending), read only */
+#define N10_TS_GPA1_DAT         0x24u
+#define N10_I2C_CTL             0x00u
+#define N10_I2C_FIFO_CTL        0x04u
+#define N10_I2C_INT_EN          0x20u
+#define N10_I2C_INT_ST          0x24u
+#define N10_I2C_FIFO_ST         0x30u
+#define N10_I2C_TX              0x34u
+#define N10_I2C_RX              0x38u
+#define N10_I2C_CONF            0x40u
+#define N10_I2C_AUTO            0x44u
+#define N10_I2C_TIMEOUT         0x48u
+#define N10_I2C_TRANS           0x50u
+#define N10_I2C_FS1             0x60u
+#define N10_I2C_ADDR            0x70u
+#define N10_I2C_USI_CON         0xc4u
+#define N10_I2C_RXCHON          (1u << 6)
+#define N10_I2C_TXCHON          (1u << 7)
+#define N10_I2C_SW_RST          (1u << 31)
+#define N10_I2C_AUTO_MODE       (1u << 31)
+#define N10_I2C_READ            (1u << 16)
+#define N10_I2C_STOP            (1u << 17)
+#define N10_I2C_RUN             (1u << 31)
+#define N10_I2C_TIMEOUT_EN      (1u << 31)
+#define N10_I2C_INT_DONE        (1u << 7)
+#define N10_I2C_INT_NODEV       (1u << 10)
+#define N10_I2C_RX_EMPTY        (1u << 24)
+#define N10_I2C_TX_EMPTY        (1u << 8)
+#define N10_I2C_MASTER_BUSY     (1u << 17)
+#define N10_I2C_ST_NO_ACK       0xbu            /* TRANS_STATUS master state (USI v2) */
+#define N10_TS_ADDR7            0x48u
+#define N10_TS_PERIOD_NS        16000000ull     /* ~60 Hz */
+#define N10_TS_FIRST_NS         2000000000ull
+#define N10_TS_MAX_FAILS        8u
+#define N10_TS_SLOTS            10u
+#define N10_TS_EV               16u
+#define N10_TS_EVS              32u             /* 1 + left (5 bits, <= 31) */
+#define N10_TS_REC              0x68u           /* IOHIDDigitizerEventData (iOS 16.7.16 IOKit event size table, type 11) */
+#define N10_TS_HDR              0x1cu           /* IOHIDSystemQueueElement header (IOHIDEventCreateWithBytes) */
+#define N10_TS_QUEUE            0x8000u
+#define N10_TS_T_LINES          160u
+#define N10_TS_E_LINES          16u
+#define N10_TS_U_LINES          48u
+#define N10_TS_U_MAX            96u
+#define N10_TS_Q_LINES          64u
+#define N10_TS_S_LINES          16u
+static const uint32_t n10_ts_fs[3] = { 0x1f0ff00u, 0x30003e0u, 0x210000u };    /* Linux 400 kHz FS1..FS3 */
+
+struct n10_ts_slot {
+	uint16_t x, y;
+	uint8_t down, chg;                      /* chg 0 none, 1 press, 2 move, 3 release (this batch) */
+};
