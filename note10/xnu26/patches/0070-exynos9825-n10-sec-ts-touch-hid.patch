+static uint32_t n10_ts_fails, n10_ts_errs, n10_ts_blines;
+static uint32_t n10_ts_ticks, n10_ts_reads, n10_ts_events, n10_ts_status, n10_ts_gesture, n10_ts_tlines, n10_ts_slines;
+static uint32_t n10_ts_frames, n10_ts_noclient, n10_ts_full, n10_ts_qlines, n10_ts_qlast;
