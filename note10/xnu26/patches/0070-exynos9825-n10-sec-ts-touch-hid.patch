+static uint8_t n10_ts_ev[N10_TS_EV * N10_TS_EVS];
+static uint8_t n10_ts_frame[N10_TS_HDR + (1u + N10_TS_SLOTS) * N10_TS_REC];
+
+static inline uint32_t
+n10_ts_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(n10_ts_va + off);
+}
+
+static inline void
+n10_ts_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(n10_ts_va + off) = v;
+}
+
+/* Read-check of the Linux configuration; saves CTL / CONF / ADDR when it passes. One N404B line (at most 8). */
+static bool
+n10_ts_bus_check(const char *why)
+{
+	uint32_t conf = n10_ts_rd(N10_I2C_CONF), ctl = n10_ts_rd(N10_I2C_CTL), usi = n10_ts_rd(N10_I2C_USI_CON);
+	uint32_t trans = n10_ts_rd(N10_I2C_TRANS), fifo = n10_ts_rd(N10_I2C_FIFO_ST), addr = n10_ts_rd(N10_I2C_ADDR);
+	uint32_t fs[3];
+	bool ok;
+
+	for (uint32_t i = 0; i < 3; i++) {
+		fs[i] = n10_ts_rd(N10_I2C_FS1 + 4u * i);
+	}
+	ok = (conf & N10_I2C_AUTO_MODE) != 0 && fs[0] == n10_ts_fs[0] && fs[1] == n10_ts_fs[1] && fs[2] == n10_ts_fs[2] &&
+	    usi == 0 && (trans & N10_I2C_MASTER_BUSY) == 0;
+	if (ok) {
+		n10_ts_sv_ctl = ctl & ~(N10_I2C_SW_RST | N10_I2C_TXCHON | N10_I2C_RXCHON);
+		n10_ts_sv_conf = conf;
+		n10_ts_sv_addr = addr;
+	}
+	if (n10_ts_blines++ < 8u) {
+		n10_dsslog_trace("N404B %s conf=0x%x ctl=0x%x fs=0x%x/0x%x/0x%x usi=0x%x trans=0x%x fifo=0x%x addr=0x%x ok=%u", why,
+		    conf, ctl, fs[0], fs[1], fs[2], usi, trans, fifo, addr, ok ? 1u : 0u);
+	}
+	return ok;
+}
+
+/* Linux exynos5_i2c_reset: SW_RST set / clear, then the saved timing and configuration. */
+static void
+n10_ts_reset(void)
+{
+	n10_ts_wr(N10_I2C_CTL, n10_ts_rd(N10_I2C_CTL) | N10_I2C_SW_RST);
+	n10_ts_wr(N10_I2C_CTL, n10_ts_rd(N10_I2C_CTL) & ~N10_I2C_SW_RST);
+	for (uint32_t i = 0; i < 3; i++) {
+		n10_ts_wr(N10_I2C_FS1 + 4u * i, n10_ts_fs[i]);
+	}
+	n10_ts_wr(N10_I2C_ADDR, n10_ts_sv_addr);
+	n10_ts_wr(N10_I2C_CONF, n10_ts_sv_conf);
+	n10_ts_wr(N10_I2C_CTL, n10_ts_sv_ctl);
+}
+
+static bool
+n10_ts_nack(void)
+{
+	return (n10_ts_rd(N10_I2C_INT_ST) & N10_I2C_INT_NODEV) != 0 ||
+	       (n10_ts_rd(N10_I2C_TRANS) & 0xfu) == N10_I2C_ST_NO_ACK;
+}
+
+/* One polled message (Linux exynos5_i2c_xfer_msg HSI2C_POLLING, stop after every message): 0 or the stage. */
+static uint32_t
+n10_ts_xfer(bool rx, uint8_t *buf, uint32_t len)
+{
+	uint32_t budget = 2000u + len * 40u, got = 0, v;
+	uint32_t trig = len >= 8u ? 8u : len;
+	uint32_t ctl = n10_ts_rd(N10_I2C_CTL) & ~(N10_I2C_TXCHON | N10_I2C_RXCHON);
+	uint32_t ac = n10_ts_rd(N10_I2C_AUTO) | N10_I2C_STOP;
+	uint32_t addr = n10_ts_rd(N10_I2C_ADDR) & ~((0x3ffu << 10) | 0x3ffu | (0xffu << 24));
+
+	n10_ts_wr(N10_I2C_INT_ST, n10_ts_rd(N10_I2C_INT_ST));
+	n10_ts_wr(N10_I2C_TIMEOUT, n10_ts_rd(N10_I2C_TIMEOUT) & ~N10_I2C_TIMEOUT_EN);
+	n10_ts_wr(N10_I2C_FIFO_CTL, 0x3u | (trig << 4) | (trig << 16));
+	if (rx) {
+		ctl |= N10_I2C_RXCHON;
+		ac |= N10_I2C_READ;
+	} else {
+		ctl |= N10_I2C_TXCHON;
+		ac &= ~N10_I2C_READ;
+	}
+	n10_ts_wr(N10_I2C_ADDR, addr | (0x7u << 24) | (N10_TS_ADDR7 << 10));
+	n10_ts_wr(N10_I2C_CTL, ctl);
+	n10_ts_wr(N10_I2C_INT_EN, N10_I2C_INT_DONE);
+	n10_ts_wr(N10_I2C_AUTO, (ac & ~0xffffu) | len);
+	n10_ts_wr(N10_I2C_AUTO, n10_ts_rd(N10_I2C_AUTO) | N10_I2C_RUN);
+	while (got < len) {
+		if (rx) {
+			if ((n10_ts_rd(N10_I2C_FIFO_ST) & N10_I2C_RX_EMPTY) == 0) {
+				buf[got++] = (uint8_t)n10_ts_rd(N10_I2C_RX);
+				continue;
+			}
+		} else if ((n10_ts_rd(N10_I2C_FIFO_ST) & 0x7fu) < 16u) {
+			n10_ts_wr(N10_I2C_TX, buf[got++]);
+			continue;
+		}
+		if (n10_ts_nack()) {
+			return 3;
+		}
+		if (budget-- == 0) {
+			return rx ? 2u : 1u;
+		}
+		IODelay(1);
+	}
+	for (;;) {
+		v = n10_ts_rd(N10_I2C_INT_ST);
+		if ((v & N10_I2C_INT_DONE) != 0 && (n10_ts_rd(N10_I2C_FIFO_ST) & N10_I2C_TX_EMPTY) != 0) {
+			n10_ts_wr(N10_I2C_INT_ST, v);
+			return 0;
+		}
+		if (n10_ts_nack()) {
+			return 3;
+		}
+		if (budget-- == 0) {
+			return 4;
+		}
+		IODelay(1);
+	}
+}
+
+/* Register select (+ read of rlen bytes). Failure: N404E, controller reset + read-check, stop after 8 in a row. */
+static bool
+n10_ts_cmd(uint8_t reg, uint8_t *rbuf, uint32_t rlen)
+{
+	uint8_t r = reg;
+	uint32_t stage = n10_ts_xfer(false, &r, 1);
+
+	if (stage == 0 && rlen != 0) {
+		stage = n10_ts_xfer(true, rbuf, rlen);
+	}
+	if (stage == 0) {
+		n10_ts_fails = 0;
+		return true;
+	}
+	uint32_t n = ++n10_ts_errs;
+	if (n <= N10_TS_E_LINES || (n & 63u) == 0) {
+		n10_dsslog_trace("N404E reg=0x%x len=%u stage=%u trans=0x%x int=0x%x fifo=0x%x n=%u", reg, rlen, stage,
+		    n10_ts_rd(N10_I2C_TRANS), n10_ts_rd(N10_I2C_INT_ST), n10_ts_rd(N10_I2C_FIFO_ST), n);
+	}
+	n10_ts_reset();
+	if (++n10_ts_fails >= N10_TS_MAX_FAILS || !n10_ts_bus_check("rst")) {
+		n10_ts_state = 2;
+	}
+	return false;
+}
+
+static inline void
+n10_ts_put32(uint8_t *o, uint32_t off, uint32_t v)
+{
+	memcpy(o + off, &v, sizeof(v));
+}
+
+/* Normalized IOFixed 16.16 (0..0x10000) of a raw coordinate. */
+static uint32_t
+n10_ts_norm(uint32_t raw, uint32_t max)
+{
+	return raw >= max ? 0x10000u : (uint32_t)(((uint64_t)raw << 16) / max);
+}
+
+/*
+ * One 0x68-byte digitizer record. Offsets from iOS 16.7.16 IOKit
+ * IOHIDEventCreateDigitizerEvent / IOHIDEventCreateDigitizerFingerEvent and
+ * IOHIDEventGetIntegerValue (emulated): +0 size, +4 type 11, +8 options
+ * (bit0 absolute, bit1 collection, bit16 range, bit17 touch, bit19 display
+ * integrated), +0xc depth, +0x10/+0x14/+0x18 x/y/z IOFixed, +0x1c index,
+ * +0x20 transducer type, +0x24 identity, +0x28 event mask, +0x2c child
+ * event mask, +0x30 buttons, +0x40 orientation type (2 quality, then quality,
+ * density, irregularity 1.0, major / minor radius 5.0 as the finger creator).
+ */
+static void
+n10_ts_rec(uint8_t *o, uint32_t options, uint32_t depth, uint32_t x, uint32_t y, uint32_t index, uint32_t ttype,
+    uint32_t mask, uint32_t child)
+{
+	bzero(o, N10_TS_REC);
+	n10_ts_put32(o, 0x00, N10_TS_REC);
+	n10_ts_put32(o, 0x04, 11u);
+	n10_ts_put32(o, 0x08, options);
+	o[0x0c] = (uint8_t)depth;
+	n10_ts_put32(o, 0x10, x);
+	n10_ts_put32(o, 0x14, y);
+	n10_ts_put32(o, 0x1c, index);
+	n10_ts_put32(o, 0x20, ttype);
+	n10_ts_put32(o, 0x24, index);
+	n10_ts_put32(o, 0x28, mask);
+	n10_ts_put32(o, 0x2c, child);
+	if (ttype == 2u) {
+		n10_ts_put32(o, 0x40, 2u);
+		n10_ts_put32(o, 0x44, 0x10000u);
+		n10_ts_put32(o, 0x48, 0x10000u);
+		n10_ts_put32(o, 0x4c, 0x10000u);
+		n10_ts_put32(o, 0x50, 5u << 16);
+		n10_ts_put32(o, 0x54, 5u << 16);
+	}
+}
+
+/* One queue entry when a slot changed: hand collection (depth 0) + one finger per active / changed slot (depth 1). */
+static void
+n10_ts_emit(void)
+{
+	uint8_t *f = n10_ts_frame, *r = n10_ts_frame + N10_TS_HDR + N10_TS_REC;
+	uint32_t n = 0, chg = 0, down = 0, mask = 0, hx = 0, hy = 0;
+	uint64_t now = mach_absolute_time(), sender = n10_ts_svc != NULL ? n10_ts_svc->getRegistryEntryID() : 0;
+	bool ok = false, sent = false;
+
+	for (uint32_t s = 0; s < N10_TS_SLOTS; s++) {
+		chg |= n10_ts_slots[s].chg;
+	}
+	if (chg == 0) {
+		return;
+	}
+	for (uint32_t s = 0; s < N10_TS_SLOTS; s++) {
+		struct n10_ts_slot *sl = &n10_ts_slots[s];
+		if (sl->chg == 0 && !sl->down) {
+			continue;
+		}
+		uint32_t m = sl->chg == 1 ? 0x23u : sl->chg == 2 ? 0x4u : sl->chg == 3 ? 0x3u : 0u;
+		uint32_t x = n10_ts_norm(sl->x, n10_ts_max_x), y = n10_ts_norm(sl->y, n10_ts_max_y);
+		n10_ts_rec(r, 0x80001u | (sl->down ? 0x30000u : 0u), 1, x, y, s + 1u, 2u, m, 0);
+		if (n == 0) {
+			hx = x;
+			hy = y;
+		}
+		r += N10_TS_REC;
+		n++;
+		down |= sl->down;
+		mask |= m;
+		sl->chg = 0;
+	}
+	n10_ts_rec(f + N10_TS_HDR, 0x80003u | (down ? 0x30000u : 0u), 0, hx, hy, 0, 3u, mask, mask);
+	memcpy(f, &now, sizeof(now));
+	memcpy(f + 8, &sender, sizeof(sender));
+	n10_ts_put32(f, 0x10, 0);
+	n10_ts_put32(f, 0x14, 0);
+	n10_ts_put32(f, 0x18, n + 1u);
+	IOLockLock(n10_ts_lock);
+	if (n10_ts_opened != 0 && n10_ts_owner != NULL) {
+		sent = true;
+		ok = n10_ts_q->enqueue(f, N10_TS_HDR + (n + 1u) * N10_TS_REC);
+	}
+	IOLockUnlock(n10_ts_lock);
+	if (ok) {
+		n10_ts_frames++;
+	} else if (sent) {
+		n10_ts_full++;
+	} else {
+		n10_ts_noclient++;
+	}
+	uint64_t sec;
+	nanoseconds_to_absolutetime(1000000000ull, &sec);
+	uint32_t sum = n10_ts_frames + n10_ts_full + n10_ts_noclient;
+	if (sum != n10_ts_qlast && now - n10_ts_q_at >= sec && n10_ts_qlines < N10_TS_Q_LINES) {
+		n10_ts_qlines++;
+		n10_ts_qlast = sum;
+		n10_ts_q_at = now;
+		n10_dsslog_trace("N404Q frames=%u noclient=%u full=%u opened=%u owner=%u fingers=%u", n10_ts_frames,
+		    n10_ts_noclient, n10_ts_full, n10_ts_opened, n10_ts_owner != NULL ? 1u : 0u, n);
+	}
+}
