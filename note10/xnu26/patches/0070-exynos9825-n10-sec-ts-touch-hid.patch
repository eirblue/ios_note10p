+/* One 16-byte event (Linux sec_ts_read_event semantics; coordinates as the reviewed note10_y771d_decode). */
+static void
+n10_ts_contact(const uint8_t *p, uint32_t left)
+{
+	uint32_t eid = p[0] & 3u;
+	char act;
+
+	if (eid != 0) {
+		uint32_t k = eid == 1u ? ++n10_ts_status : ++n10_ts_gesture;
+		if (k <= 8u && n10_ts_tlines < N10_TS_T_LINES) {
+			n10_ts_tlines++;
+			n10_dsslog_trace("N404T eid=%u n=%u b=%02x %02x %02x %02x %02x %02x %02x %02x", eid, k, p[0], p[1], p[2],
+			    p[3], p[4], p[5], p[6], p[7]);
+		}
+		return;
+	}
+	uint32_t tid = (p[0] >> 2) & 0x0fu, a = p[0] >> 6, type = ((uint32_t)(p[6] >> 6) << 2) | (p[7] >> 6);
+	if (tid == 0 || tid > N10_TS_SLOTS || a == 0 || type != 0) {
+		return;
+	}
+	uint32_t x = ((uint32_t)p[1] << 4) | (p[3] >> 4), y = ((uint32_t)p[2] << 4) | (p[3] & 0x0fu);
+	struct n10_ts_slot *sl = &n10_ts_slots[tid - 1u];
+	if (a == 1u || (a == 2u && !sl->down)) {        /* press; Linux non-strict: move on an idle slot opens it */
+		if (sl->chg == 3u) {
+			n10_ts_emit();                  /* release of this batch first */
+		}
+		sl->down = 1;
+		sl->chg = 1;
+		sl->x = (uint16_t)x;
+		sl->y = (uint16_t)y;
+		act = 'P';
+	} else if (a == 2u) {
+		sl->x = (uint16_t)x;
+		sl->y = (uint16_t)y;
+		if (sl->chg == 0) {
+			sl->chg = 2;
+		}
+		act = 'M';
+	} else {
+		if (!sl->down) {
+			return;
+		}
+		if (sl->chg == 1u) {
+			n10_ts_emit();                  /* press of this batch first */
+		}
+		sl->down = 0;
+		sl->chg = 3;                            /* release keeps the last accepted position */
+		act = 'R';
+	}
+	n10_ts_events++;
+	if (n10_ts_tlines < N10_TS_T_LINES && (n10_ts_tlines < 64u || act != 'M')) {
+		n10_ts_tlines++;
+		n10_dsslog_trace("N404T slot=%u act=%c raw=%u,%u pt=%u,%u left=%u", tid - 1u, act, x, y,
+		    x * 480u / n10_ts_max_x, y * 1013u / n10_ts_max_y, left);
+	}
+}
+
+static void
+n10_ts_init(void)
+{
+	uint8_t id[5], boot = 0, ts[4], pi[11];
+	bool ok, clr = false, sense = false;
+
+	bzero(id, sizeof(id));
+	bzero(ts, sizeof(ts));
+	bzero(pi, sizeof(pi));
+	n10_ts_va = ml_io_map(N10_TS_I2C_PA, N10_TS_I2C_SIZE);
+	n10_ts_gpa = ml_io_map(N10_TS_GPA1_PA, 0x1000u);
+	if (n10_ts_va == 0 || !n10_ts_bus_check("init")) {
+		n10_ts_state = 2;
+		return;
+	}
+	ok = n10_ts_cmd(0x22, id, 5) && id[0] == 0x53 && id[1] == 0x45 && id[2] == 0x37 && id[3] == 0x71;
+	if (ok) {
+		(void)n10_ts_cmd(0x55, &boot, 1);
+		(void)n10_ts_cmd(0xaf, ts, 4);
+		if (n10_ts_cmd(0x23, pi, 11)) {         /* note10_y771d_panel_bounds: zero count -> DT count 4096 */
+			uint32_t xc = ((uint32_t)pi[0] << 8) | pi[1], yc = ((uint32_t)pi[2] << 8) | pi[3];
+			xc = xc == 0 ? 4096u : xc;
+			yc = yc == 0 ? 4096u : yc;
+			if (xc <= 4096u && yc <= 4096u && xc > 1u && yc > 1u) {
+				n10_ts_max_x = xc - 1u;
+				n10_ts_max_y = yc - 1u;
+			}
+		}
+		clr = n10_ts_cmd(0x62, NULL, 0);        /* CLEAR_EVENT_STACK: drop events queued since the branch */
+		sense = n10_ts_cmd(0x10, NULL, 0);      /* SENSE_ON (idempotent, Linux probe / start_device) */
+	}
+	n10_dsslog_trace("N404I id=%02x%02x%02x%02x%02x boot=0x%x ts=%02x%02x%02x%02x bounds=%u/%u ok=%u clear=%u sense=%u",
+	    id[0], id[1], id[2], id[3], id[4], boot, ts[0], ts[1], ts[2], ts[3], n10_ts_max_x, n10_ts_max_y, ok ? 1u : 0u,
+	    clr ? 1u : 0u, sense ? 1u : 0u);
+	if (n10_ts_state == 0) {
+		n10_ts_state = (ok && sense) ? 1u : 2u;
+	}
+}
+
+static void
+n10_ts_poll(void)
+{
+	uint8_t *ev = n10_ts_ev;
+	uint32_t left;
+
+	if (!n10_ts_cmd(0x60, ev, N10_TS_EV)) {         /* READ_ONE_EVENT */
+		return;
+	}
+	n10_ts_reads++;
+	if (ev[0] == 0) {
+		return;                                 /* event buffer empty */
+	}
+	if ((ev[0] & 3u) == 3u) {                       /* invalid: clear the stack, release all */
+		(void)n10_ts_cmd(0x62, NULL, 0);
+		for (uint32_t s = 0; s < N10_TS_SLOTS; s++) {
+			if (n10_ts_slots[s].down) {
+				n10_ts_slots[s].down = 0;
+				n10_ts_slots[s].chg = 3;
+			}
+		}
+		n10_ts_emit();
+		return;
+	}
+	left = ev[7] & 0x1fu;
+	if (left != 0 && !n10_ts_cmd(0x61, ev + N10_TS_EV, N10_TS_EV * left)) {   /* READ_ALL_EVENT */
+		return;
+	}
+	for (uint32_t i = 0; i <= left; i++) {
+		n10_ts_contact(ev + N10_TS_EV * i, left);
+	}
+	n10_ts_emit();
+}
+
+static void
+n10_ts_tick(thread_call_param_t p0, thread_call_param_t p1)
+{
+	uint32_t t = ++n10_ts_ticks;
+	uint64_t d;
+
+	(void)p0;
+	(void)p1;
+	if (n10_ts_state == 0) {
+		n10_ts_init();
+	}
+	if (n10_ts_state == 1) {
+		n10_ts_poll();
+	}
+	if ((t % 625u == 0 || n10_ts_state == 2) && n10_ts_slines < N10_TS_S_LINES) {      /* ~10 s, and once at a stop */
+		n10_ts_slines++;
+		n10_dsslog_trace("N404S ticks=%u reads=%u events=%u status=%u gesture=%u errs=%u frames=%u state=%u attn=%u", t,
+		    n10_ts_reads, n10_ts_events, n10_ts_status, n10_ts_gesture, n10_ts_errs, n10_ts_frames, n10_ts_state,
+		    n10_ts_gpa != 0 ? (*(volatile uint32_t *)(n10_ts_gpa + N10_TS_GPA1_DAT) & 1u) : 2u);
+	}
+	if (n10_ts_state != 2) {
+		nanoseconds_to_absolutetime(N10_TS_PERIOD_NS, &d);
+		thread_call_enter_delayed(n10_ts_tmr, mach_absolute_time() + d);
+	}
+}
+
+/* User-client side (provider == n10_ts_svc). */
+static void
+n10_ts_line(const char *what, uint32_t a, uint32_t b)
+{
+	if (__atomic_fetch_add(&n10_ts_ulines, 1u, __ATOMIC_RELAXED) < N10_TS_U_MAX) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		n10_dsslog_trace("N404H %s %s pid=%d a=0x%x b=0x%x", what, name, proc_selfpid(), a, b);
+	}
+}
+
+static void
+n10_ts_open(void *client, bool open)
+{
+	if (!open) {
+		IOLockLock(n10_ts_lock);
+		if (n10_ts_owner == client) {
+			n10_ts_q->setNotificationPort(MACH_PORT_NULL);
+			n10_ts_owner = NULL;
+			n10_ts_opened = 0;
+		}
+		IOLockUnlock(n10_ts_lock);
+	}
+	n10_ts_line(open ? "open" : "close", 0, 0);
+}
+
+static void
+n10_ts_port(void *client, mach_port_t port)
+{
+	IOLockLock(n10_ts_lock);
+	n10_ts_q->setNotificationPort(port);
+	n10_ts_owner = port != MACH_PORT_NULL ? client : NULL;
+	IOLockUnlock(n10_ts_lock);
+	n10_ts_line("notify", port != MACH_PORT_NULL ? 1u : 0u, 0);
+}
+
+static IOReturn
+n10_ts_method(void *client, uint32_t selector, IOExternalMethodArguments *args)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t in_s = args->scalarInputCount, out_s = args->scalarOutputCount;
+	uint32_t in_b = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_b = args->structureOutputDescriptor != NULL ?
+	    (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+	uint64_t s0 = in_s != 0 ? args->scalarInput[0] : 0;
+
+	for (uint32_t i = 0; i < out_s; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	n10_fb_zero_struct_out(args);
+	switch (selector) {
+	case 0:                                         /* IOHIDEventServicePlugin open (one scalar: options) */
+		IOLockLock(n10_ts_lock);
+		n10_ts_opened = 1;
+		IOLockUnlock(n10_ts_lock);
+		break;
+	case 1:                                         /* close */
+		IOLockLock(n10_ts_lock);
+		if (n10_ts_owner == client || n10_ts_owner == NULL) {
+			n10_ts_opened = 0;
+		}
+		IOLockUnlock(n10_ts_lock);
+		break;
+	case 2:                                         /* copyEvent / copyMatchingEvent: no event to copy */
+	case 4:
+		ret = kIOReturnUnsupported;
+		break;
+	default:
+		break;
+	}
+	bool first = true;
+	if (selector < 64) {
+		uint32_t bit = 1u << (selector & 31);
+		first = (__atomic_fetch_or(&n10_ts_useen[selector >> 5], bit, __ATOMIC_RELAXED) & bit) == 0;
+	}
+	uint32_t ln = __atomic_load_n(&n10_ts_ulines, __ATOMIC_RELAXED);
+	if ((first || ln < N10_TS_U_LINES) && __atomic_fetch_add(&n10_ts_ulines, 1u, __ATOMIC_RELAXED) < N10_TS_U_MAX) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		n10_dsslog_trace("N404U %s sel=%u in=%u/%u out=%u/%u s0=0x%llx ret=0x%x", name, selector, in_s, in_b, out_s,
+		    out_b, (unsigned long long)s0, ret);
+	}
+	return ret;
+}
