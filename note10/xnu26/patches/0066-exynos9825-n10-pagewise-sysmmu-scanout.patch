+/* v400 map=otf: walk and check every page again, map each contiguous chunk, copy, unmap; 0 or the bad code. */
+static uint32_t
+n10_disp_copy_otf(const uint32_t *src, uint32_t bpr)
+{
+	uint64_t o0 = 0, p0 = 0, n = 0;
+
+	for (uint64_t o = 0;; o += 0x1000) {
+		uint64_t p = 0;
+		if (o < n10_disp_len) {
+			p = n10_disp_pa(o);
+			uint32_t bad = n10_disp_page_bad(p);
+			if (bad != 0) {
+				return bad;
+			}
+			if (n != 0 && p == p0 + n) {
+				n += 0x1000;
+				continue;
+			}
+		}
+		if (n != 0) {
+			uint64_t lead = p0 & (PAGE_SIZE - 1);
+			vm_size_t sz = (vm_size_t)((n + lead + PAGE_SIZE - 1) & ~(uint64_t)(PAGE_SIZE - 1));
+			vm_offset_t v = ml_io_map_unmappable((vm_offset_t)p0, (vm_size_t)n, N10_WIMG_WCOMB);
+			n10_disp_put(o0, o0 + n < n10_disp_len ? o0 + n : n10_disp_len, v, src, bpr);
+			ml_io_unmap(v - lead, sz);
+		}
+		if (o >= n10_disp_len) {
+			return 0;
+		}
+		o0 = o;
+		p0 = p;
+		n = 0x1000;
+	}
+}
