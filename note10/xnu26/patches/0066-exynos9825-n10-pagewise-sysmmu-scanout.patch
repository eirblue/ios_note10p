+/* v400: n source pixels (BGRA) into the window buffer in the armed byte order (the 0064 / 0065 conversions). */
+static void
+n10_disp_cvt(uint32_t *d, const uint32_t *s, uint32_t n)
+{
+	const uint32_t m = n10_disp_swap_rb;
+
+	for (uint32_t x = 0; x < n; x++) {
+		uint32_t v = s[x];
+		if (m == 1u) {
+			v = (v & 0xff00ff00u) | ((v & 0xffu) << 16) | ((v >> 16) & 0xffu);
+		} else if (m == 2u) {                   /* v399 ABGR8888 as bytes R,G,B,A; alpha 0xff */
+			v = 0xff000000u | (v & 0x0000ff00u) | ((v & 0xffu) << 16) | ((v >> 16) & 0xffu);
+		} else if (m == 3u) {                   /* v399 ABGR8888 as bytes A,B,G,R; alpha 0xff */
+			v = (v << 8) | 0xffu;
+		}
+		d[x] = v;
+	}
+}
