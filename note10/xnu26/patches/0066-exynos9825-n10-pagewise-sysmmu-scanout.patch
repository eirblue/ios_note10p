+/* v400: the visible pixels of scanned-row bytes [o, end) (end <= n10_disp_len) into va (= mapping of offset o). */
+static void
+n10_disp_put(uint64_t o, uint64_t end, vm_offset_t va, const uint32_t *src, uint32_t bpr)
+{
+	const uint64_t o0 = o;
+
+	while (o < end) {
+		uint32_t y = (uint32_t)(o / n10_disp_stride), x = (uint32_t)(o % n10_disp_stride) / 4u;
+		uint64_t stop = (uint64_t)y * n10_disp_stride + N10_FB_WIDTH * 4u;
+		if (x >= N10_FB_WIDTH) {                /* stride padding: next row */
+			o = (uint64_t)(y + 1) * n10_disp_stride;
+			continue;
+		}
+		stop = stop < end ? stop : end;
+		n10_disp_cvt((uint32_t *)(va + (o - o0)), src + (uint64_t)y * (bpr / 4u) + x,
+		    (uint32_t)((stop - o) / 4u));
+		o = stop;
+	}
+}
