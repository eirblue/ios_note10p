+/*
+ * v380: one-line snapshot of a thread recorded by the bsd/dev/arm/systemcalls.c
+ * N380T slots, called from the heartbeat (timer interrupt, CPU0). Every field
+ * is copied with ml_nofault_copy, so a freed or unmapped thread cannot fault;
+ * a thread_id mismatch (freed, maybe reused) returns 0. Appends
+ * " st=<state> bh=<block_hint> we=<wait_event or u+off into its uthread>
+ * pri=<sched_pri> sc=<thread>/<task suspend count> pc=<user pc>" to buf.
+ */
+int n10_thread_peek(const void *thp, uint64_t tid, char *buf, int len);
+
+#define N10_PEEK(src, dst) \
+	(ml_nofault_copy((vm_offset_t)&(src), (vm_offset_t)&(dst), sizeof(dst)) == sizeof(dst))
+
+int
+n10_thread_peek(const void *thp, uint64_t tid, char *buf, int len)
+{
+	struct thread *th = (struct thread *)(uintptr_t)thp;
+	__typeof__(th->thread_id) id = 0;
+	__typeof__(th->state) st = 0;
+	__typeof__(th->wait_event) we = 0;
+	__typeof__(th->block_hint) bh = kThreadWaitNone;
+	__typeof__(th->suspend_count) tsc = 0;
+	__typeof__(th->sched_pri) pri = 0;
+	__typeof__(th->t_tro) tro = NULL;
+	__typeof__(th->machine.upcb) upcb = NULL;
+	struct task *task = NULL;
+	int ksc = -1, n;
+	arm_saved_state_t ss;
+	uint64_t pc = 0, ut = (uint64_t)(uintptr_t)th + sizeof(struct thread), wev;
+
+	if (th == NULL || buf == NULL || len <= 0 ||
+	    !N10_PEEK(th->thread_id, id) || id != tid ||
+	    !N10_PEEK(th->state, st) || !N10_PEEK(th->wait_event, we) ||
+	    !N10_PEEK(th->block_hint, bh) || !N10_PEEK(th->suspend_count, tsc) ||
+	    !N10_PEEK(th->sched_pri, pri)) {
+		return 0;
+	}
+	if (N10_PEEK(th->t_tro, tro) && tro != NULL && N10_PEEK(tro->tro_task, task) && task != NULL) {
+		(void)N10_PEEK(task->suspend_count, ksc);
+	}
+	if (N10_PEEK(th->machine.upcb, upcb) && upcb != NULL && N10_PEEK(*upcb, ss)) {
+		pc = (uint64_t)get_saved_state_pc(&ss);
+	}
+	wev = (uint64_t)we;
+	if (wev >= ut && wev - ut < 0x1000) {
+		n = snprintf(buf, (size_t)len, " st=%x bh=%x we=u+0x%llx pri=%d sc=%d/%d pc=0x%llx",
+		    (unsigned)st, (unsigned)bh, wev - ut, (int)pri, (int)tsc, ksc, pc);
+	} else {
+		n = snprintf(buf, (size_t)len, " st=%x bh=%x we=0x%llx pri=%d sc=%d/%d pc=0x%llx",
+		    (unsigned)st, (unsigned)bh, wev, (int)pri, (int)tsc, ksc, pc);
+	}
+	if (n < 0) {
+		return 0;
+	}
+	return n < len ? n : len - 1;
+}
