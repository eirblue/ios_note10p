+/* Append one bounded line (text without newline, n chars) if it changed since this key's last line. */
+static void
+n10_xq_emit(char *line, int n, int cap, uint32_t *last)
+{
+	uint32_t sum = 2166136261u;
+
+	if (n < 0) {
+		return;
+	}
+	if (n > cap - 2) {
+		n = cap - 2;
+	}
+	for (int k = 0; k < n; k++) {
+		sum = (sum ^ (uint8_t)line[k]) * 16777619u;
+	}
+	if (sum == *last || __atomic_fetch_add(&n10_xq_lines, 1u, __ATOMIC_RELAXED) >= N10_XQ_LINES) {
+		return;
+	}
+	*last = sum;
+	line[n++] = '\n';
+	n10_dsslog_write(line, n);
+}
