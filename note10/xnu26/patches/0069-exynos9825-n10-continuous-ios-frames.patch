+			n10_disp_frame(0, 2);
+		}
 	}
-	if (tick <= 4u || (tick & 7u) == 0 || re != 0 || seen != 0 || tick >= N10_DISP_TMR_TICKS) {
+	if (tick <= 4u || (tick & 7u) == 0 || re != 0 || (seen != 0 && n10_disp_se_logged++ == 0) ||
