+		sen = ++n10_disp_se_frames;
+		n10_disp_se_ok_at = n10_disp_last;
+	}
+	if (!ok || n <= N10_DISP_FRAME_LINES || (n & 7u) == 0 || (sen != 0 && sen <= 8u)) {
 		n10_dsslog_trace("N398F ok=%u n=%u surf=%u how=%u polls=%u sur=0x%x skips=%u hash=0x%08x", ok, n, want,
 		    how, polls, sur, __atomic_load_n(&n10_disp_skips, __ATOMIC_RELAXED), hash);
 	}
@@ -2037,13 +2055,19 @@ n10_disp_tick(thread_call_param_t p0, thread_call_param_t p1)
