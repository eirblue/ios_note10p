diff --git a/osfmk/arm64/note10/n10_smp.c b/osfmk/arm64/note10/n10_smp.c
new file mode 100644
index 0000000..bd1e215
--- /dev/null
+++ b/osfmk/arm64/note10/n10_smp.c
@@ -0,0 +1,333 @@
+/*
+ * Note10 (v412): secondary CPUs under XNU.
+ *
+ * v410 / v411 r1: XNU ran on CPU0 only (EXYNOS9825.h MAX_CPUS 1; no IOCPU / AppleARMCPU kext, so nothing called
+ * ml_processor_register). About 100 daemons start from ~49 s and lsd got 2 of ~70 CPU0 samples; its LaunchServices
+ * database scan did not finish in the 300 s window and SpringBoard waited on lsd. v412 raises MAX_CPUS to 4: ADT
+ * /cpus cpu0..cpu3 = the cluster0 Cortex-A55 cores (Linux DT reg 0..3, enable-method psci), the boot CPU's own core
+ * type, cluster, power domain and DVFS domain. The A75 (reg 4, 5) and M4 (reg 0x100, 0x101) cores stay off. The
+ * controller offlines Linux CPUs 1-7 (hotplug, PSCI CPU_OFF) before the actor, so EL3 holds them OFF and CPU_ON is
+ * valid; a core Linux kept online answers ALREADY_ON and simply is not used.
+ *
+ *   n10_smp_boot()              bsd_init, before launchd: ml_processor_register for the boot CPU (processor_boot,
+ *                               cpu_machine_init: cpu_signal enabled by a self-SGI), then for cpus 1..3
+ *                               (processor_boot -> processor_dostartup -> cpu_start -> n10_smp_cpu_on)
+ *   n10_smp_cpu_on()            PSCI CPU_ON (SMC64 0xC4000003, target = ADT reg, entry = PA of n10_smp_entry
+ *                               (start.s), context id = PA of the cpu data); asynchronous, result in N412S
+ *   n10_smp_cpu_machine_init()  cpu_machine_init on every CPU instead of IOCPU::initCPU: GIC banked setup on a
+ *                               secondary (pe_note10_cpu_init), self-SGI, ml_cpu_up when interrupts are on (boot
+ *                               CPU, as PE_cpu_machine_init), N412O
+ *   n10_smp_signal()            cpu_signal IPIs = GIC SGI 0 (pe_note10_send_ipi); n10_smp_ipi() is its handler
+ *   n10_smp_sample()            per-CPU timer IRQ sample (busy = not the idle thread, lsd = proc name "lsd")
+ *   n10_smp_tick()              CPU0 watchdog timer (250 ms): N412Q every 10 s until the quiet phase (run =
+ *                               runnable threads, per CPU state and sample deltas), one N412T for a core that is not
+ *                               online 5 s after CPU_ON
+ *   n10_smp_final()             window end: N412F totals
+ *   n10_smp_badirq()            N412I for an interrupt source pe_note10_handle_irq disabled (cap 16)
+ *
+ * Fail-safe: nothing here waits for a secondary. A core that never comes online stays PROCESSOR_START (never
+ * dispatched to; timeshare threads use the shared pset run queue) and only costs its N412T line; XNU continues on
+ * the CPUs that came up. The watchdog pet stays a CPU0 timer call (n10_wdt.c: armed on CPU0 before any secondary
+ * exists and re-armed from its own callout, so it stays on CPU0's timer queue). Observation counters are per CPU and
+ * written only by their own CPU; CPU0 reads them unlocked (32-bit, record only).
+ */
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+#include <machine/machine_routines.h>
+#include <kern/clock.h>
+#include <kern/cpu_number.h>
+#include <kern/processor.h>
+#include <kern/sched.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <arm/cpu_data.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/caches_internal.h>
+#include <arm/machine_cpu.h>
+#include <arm/machine_routines.h>
+#include <arm/pmap.h>
+#include <string.h>
+
+#define N10_PSCI_CPU_ON         0xc4000003ull   /* SMC64; Linux DT /psci cpu_on, method smc */
+#define N10_SMP_ONLINE_NS       5000000000ull   /* N412T when a core is not online 5 s after CPU_ON */
+#define N10_SMP_Q_EVERY         40u             /* 250 ms watchdog ticks: N412Q every 10 s */
+#define N10_SMP_BAD_MAX         16u             /* N412I cap */
+
+enum { N10_SMP_NONE = 0, N10_SMP_PENDING, N10_SMP_FAILED, N10_SMP_UP };
+
+extern void n10_smp_entry(void);                /* osfmk/arm64/start.s */
+extern int pe_note10_cpu_init(unsigned int cpu);        /* pexpert/arm/pe_note10_irq.c */
+extern int pe_note10_send_ipi(unsigned int cpu);
+extern void n10_dsslog_trace(const char *fmt, ...) __printflike(1, 2);
+extern void n10_dsslog_write(const char *s, int n);
+extern void n10_dsslog_final(const char *s, int n);
+extern int snprintf(char *, size_t, const char *, ...) __printflike(3, 4);
+extern char *proc_name_address(void *p);
+extern void *get_bsdtask_info(task_t t);
+
+void n10_smp_boot(void);
+void n10_smp_cpu_on(cpu_data_t *cdp);
+void n10_smp_cpu_machine_init(unsigned int cpu, boolean_t boot);
+void n10_smp_signal(cpu_data_t *target);
+void n10_smp_ipi(void);
+void n10_smp_sample(void);
+void n10_smp_tick(bool quiet);
+void n10_smp_final(void);
+void n10_smp_badirq(uint32_t intid);
+
+static struct {
+	uint32_t state;
+	int32_t psci;                   /* CPU_ON return value (x0, low word) */
+	uint64_t on_abs, up_abs;
+	uint32_t mpidr, gic;
+	uint32_t irq, busy, lsd, ipi;   /* written only by that CPU */
+	uint32_t irq0, busy0, lsd0;     /* at the previous N412Q (CPU0) */
+	bool late_logged;
+} n10_smp[MAX_CPUS];
+static bool n10_smp_started;
+static uint32_t n10_smp_ticks, n10_smp_bad, n10_smp_bad_lines;
+
+static uint32_t
+n10_smp_ms(uint64_t abs)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+static int64_t
+n10_smp_psci_on(uint64_t target, uint64_t entry, uint64_t context)
+{
+	register uint64_t x0 __asm__("x0") = N10_PSCI_CPU_ON;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = entry;
+	register uint64_t x3 __asm__("x3") = context;
+
+	/* SMCCC: x0-x3 results, x4-x17 not preserved, x18-x30 / SP preserved */
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return (int64_t)x0;
+}
+
+static void
+n10_smp_register(const ml_topology_cpu_t *c)
+{
+	ml_processor_info_t info;
+	processor_t processor = PROCESSOR_NULL;
+	ipi_handler_t ipi = NULL;
+	perfmon_interrupt_handler_func pmi = NULL;
+	kern_return_t kr;
+
+	bzero(&info, sizeof(info));
+	info.cpu_id = (cpu_id_t)(uintptr_t)(c->cpu_id + 1);    /* opaque: the PE_cpu_* users are bypassed */
+	info.phys_id = c->phys_id;
+	info.log_id = c->cpu_id;
+	info.cluster_id = c->cluster_id;
+	info.cluster_type = c->cluster_type;
+	info.l2_cache_id = c->l2_cache_id;
+	info.l2_cache_size = c->l2_cache_size;
+	info.l3_cache_id = c->l3_cache_id;
+	info.l3_cache_size = c->l3_cache_size;
+	kr = ml_processor_register(&info, &processor, &ipi, &pmi);
+	if (kr != KERN_SUCCESS) {
+		n10_dsslog_trace("N412R cpu=%u kr=%d", c->cpu_id, kr);
+	}
+}
+
+void
+n10_smp_boot(void)
+{
+	const ml_topology_info_t *ti = ml_get_topology_info();
+	unsigned int boot = (unsigned int)ml_get_boot_cpu_number();
+
+	n10_smp_started = true;
+	n10_dsslog_trace("N412B cpus=%u boot=%u t=%u", ti->num_cpus, boot, n10_smp_ms(mach_absolute_time()));
+	n10_smp_register(&ti->cpus[boot]);      /* first: its cpu_signal must work before others can signal it */
+	for (unsigned int i = 0; i < ti->num_cpus && i < MAX_CPUS; i++) {
+		if (i != boot) {
+			n10_smp_register(&ti->cpus[i]);
+		}
+	}
+}
+
+void
+n10_smp_cpu_on(cpu_data_t *cdp)
+{
+	const ml_topology_info_t *ti = ml_get_topology_info();
+	unsigned int cpu = cdp->cpu_number;
+
+	if (cpu >= MAX_CPUS || cpu >= ti->num_cpus || CpuDataEntries[cpu].cpu_data_paddr == NULL) {
+		return;
+	}
+	uint64_t entry = ml_static_vtop((vm_offset_t)&n10_smp_entry);
+	uint64_t context = (uint64_t)(uintptr_t)CpuDataEntries[cpu].cpu_data_paddr;
+
+	/* read with the MMU off by n10_smp_entry / start_cpu; cpu_start already cleaned CpuDataEntries and the cpu data */
+	flush_dcache((vm_offset_t)&cpu_ttep, (unsigned)sizeof(cpu_ttep), FALSE);
+	flush_dcache((vm_offset_t)BootArgs, (unsigned)sizeof(*BootArgs), FALSE);
+	n10_smp[cpu].on_abs = mach_absolute_time();
+	int64_t r = n10_smp_psci_on(ti->cpus[cpu].phys_id, entry, context);
+	n10_smp[cpu].psci = (int32_t)r;
+	if (n10_smp[cpu].state != N10_SMP_UP) {
+		n10_smp[cpu].state = r == 0 ? N10_SMP_PENDING : N10_SMP_FAILED;
+	}
+	n10_dsslog_trace("N412S cpu=%u reg=0x%x psci=%d", cpu, ti->cpus[cpu].phys_id, (int)n10_smp[cpu].psci);
+}
+
+void
+n10_smp_cpu_machine_init(unsigned int cpu, boolean_t boot)
+{
+	uint64_t mpidr;
+	int gic = 1;
+
+	if (cpu >= MAX_CPUS) {
+		return;
+	}
+	__asm__ volatile ("mrs %0, mpidr_el1" : "=r" (mpidr));
+	if (cpu != (unsigned int)ml_get_boot_cpu_number()) {
+		gic = pe_note10_cpu_init(cpu);
+	}
+	n10_smp[cpu].mpidr = (uint32_t)mpidr;
+	n10_smp[cpu].gic = (uint32_t)gic;
+	n10_smp[cpu].up_abs = mach_absolute_time();
+	n10_smp[cpu].state = N10_SMP_UP;
+	/* as IOCPU::initCPU: a self-IPI, taken once interrupts are enabled, clears SIGPdisabled (cpu_signal_handler) */
+	(void)pe_note10_send_ipi(cpu);
+	n10_dsslog_trace("N412O cpu=%u mpidr=0x%x gic=%d first=%d up_ms=%u", cpu, (uint32_t)mpidr, gic, (int)boot,
+	    n10_smp[cpu].on_abs ? n10_smp_ms(n10_smp[cpu].up_abs - n10_smp[cpu].on_abs) : 0u);
+	if (ml_get_interrupts_enabled()) {
+		/* boot CPU registered from n10_smp_boot (thread context), as PE_cpu_machine_init does it */
+		boolean_t intr = ml_set_interrupts_enabled(FALSE);
+		ml_cpu_up();
+		ml_set_interrupts_enabled(intr);
+	}
+}
+
+void
+n10_smp_signal(cpu_data_t *target)
+{
+	(void)pe_note10_send_ipi(target->cpu_number);
+}
+
+void
+n10_smp_ipi(void)
+{
+	unsigned int cpu = (unsigned int)cpu_number();
+
+	if (cpu < MAX_CPUS) {
+		n10_smp[cpu].ipi++;
+	}
+	cpu_signal_handler();
+}
+
+void
+n10_smp_sample(void)
+{
+	unsigned int cpu = (unsigned int)cpu_number();
+	thread_t th = current_thread();
+
+	if (!n10_smp_started || cpu >= MAX_CPUS) {
+		return;
+	}
+	n10_smp[cpu].irq++;
+	if (th == THREAD_NULL || th == current_processor()->idle_thread || th->t_tro == NULL) {
+		return;
+	}
+	n10_smp[cpu].busy++;
+	void *bp = get_bsdtask_info(get_threadtask(th));
+	const char *nm = bp != NULL ? proc_name_address(bp) : NULL;
+	if (nm != NULL && nm[0] == 'l' && nm[1] == 's' && nm[2] == 'd' && nm[3] == '\0') {
+		n10_smp[cpu].lsd++;
+	}
+}
+
+static char
+n10_smp_state(unsigned int cpu)
+{
+	switch (n10_smp[cpu].state) {
+	case N10_SMP_PENDING:
+		return 'P';
+	case N10_SMP_FAILED:
+		return 'F';
+	case N10_SMP_UP:
+		return (cpu_datap((int)cpu)->cpu_signal & SIGPdisabled) ? 'S' : 'U';
+	default:
+		return '-';
+	}
+}
+
+void
+n10_smp_tick(bool quiet)
+{
+	char ub[256];
+	int n, m;
+	uint64_t now;
+	unsigned int count = ml_get_topology_info()->num_cpus;
+
+	if (!n10_smp_started || quiet || ++n10_smp_ticks % N10_SMP_Q_EVERY != 0) {
+		return;
+	}
+	now = mach_absolute_time();
+	n = snprintf(ub, sizeof(ub) - 2, "N412Q t=%u run=%u", n10_smp_ms(now), sched_run_buckets[TH_BUCKET_RUN]);
+	if (n <= 0 || n >= (int)sizeof(ub) - 2) {
+		return;
+	}
+	for (unsigned int cpu = 0; cpu < count && cpu < MAX_CPUS; cpu++) {
+		uint32_t irq = n10_smp[cpu].irq, busy = n10_smp[cpu].busy, lsd = n10_smp[cpu].lsd;
+		m = snprintf(ub + n, sizeof(ub) - 2 - (size_t)n, " %u%c%u/%u/%u", cpu, n10_smp_state(cpu),
+		    busy - n10_smp[cpu].busy0, irq - n10_smp[cpu].irq0, lsd - n10_smp[cpu].lsd0);
+		n10_smp[cpu].irq0 = irq;
+		n10_smp[cpu].busy0 = busy;
+		n10_smp[cpu].lsd0 = lsd;
+		if (m <= 0 || n + m >= (int)sizeof(ub) - 2) {
+			break;
+		}
+		n += m;
+	}
+	ub[n++] = '\n';
+	n10_dsslog_write(ub, n);
+	for (unsigned int cpu = 0; cpu < count && cpu < MAX_CPUS; cpu++) {
+		if (n10_smp[cpu].state == N10_SMP_PENDING && !n10_smp[cpu].late_logged &&
+		    n10_smp_ms(now - n10_smp[cpu].on_abs) >= (uint32_t)(N10_SMP_ONLINE_NS / NSEC_PER_MSEC)) {
+			n10_smp[cpu].late_logged = true;
+			n10_dsslog_trace("N412T cpu=%u psci=%d waited_ms=%u", cpu, (int)n10_smp[cpu].psci,
+			    n10_smp_ms(now - n10_smp[cpu].on_abs));
+		}
+	}
+}
+
+void
+n10_smp_final(void)
+{
+	char ub[256];
+	int n, m;
+	unsigned int count = ml_get_topology_info()->num_cpus;
+
+	n = snprintf(ub, sizeof(ub) - 2, "N412F run=%u bad=%u", sched_run_buckets[TH_BUCKET_RUN], n10_smp_bad);
+	if (n <= 0 || n >= (int)sizeof(ub) - 2) {
+		return;
+	}
+	for (unsigned int cpu = 0; cpu < count && cpu < MAX_CPUS; cpu++) {
+		m = snprintf(ub + n, sizeof(ub) - 2 - (size_t)n, " %u%c%u/%u/%u/%u", cpu, n10_smp_state(cpu),
+		    n10_smp[cpu].busy, n10_smp[cpu].irq, n10_smp[cpu].lsd, n10_smp[cpu].ipi);
+		if (m <= 0 || n + m >= (int)sizeof(ub) - 2) {
+			break;
+		}
+		n += m;
+	}
+	ub[n++] = '\n';
+	n10_dsslog_final(ub, n);
+}
+
+void
+n10_smp_badirq(uint32_t intid)
+{
+	(void)__atomic_fetch_add(&n10_smp_bad, 1u, __ATOMIC_RELAXED);
+	if (__atomic_fetch_add(&n10_smp_bad_lines, 1u, __ATOMIC_RELAXED) < N10_SMP_BAD_MAX) {
+		n10_dsslog_trace("N412I cpu=%d intid=%u disabled", cpu_number(), intid);
+	}
+}
