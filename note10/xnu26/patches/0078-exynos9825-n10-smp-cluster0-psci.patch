+/* v412: on secondary CPU cpu (interrupts masked, before they are enabled); 1 = CPU interface on, one target bit. */
+int
+pe_note10_cpu_init(unsigned int cpu)
+{
+    if (!note10_irq_ready || cpu==0 || cpu>=N10_SMP_MAX) return 0;
+    for (uint32_t i=0;i<8;++i) *note10_gicd(N10_GICD_IPRIORITYR+4*i)=note10_prio[i];
+    *note10_gicd(N10_GICD_ISENABLER0)=(1U<<N10_IPI_SGI)|(1U<<note10_timer_intid);
+    *note10_gicc(N10_GICC_BPR)=note10_bpr;
+    *note10_gicc(N10_GICC_PMR)=note10_pmr;
+    __builtin_arm_dsb(15);
+    *note10_gicc(N10_GICC_CTLR)=note10_cctlr;
+    __builtin_arm_dsb(15);
