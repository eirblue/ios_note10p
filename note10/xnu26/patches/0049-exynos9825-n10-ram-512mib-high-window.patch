diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index d5f0ca0..d2de176 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -31,6 +31,13 @@
 #include <arm64/machine_machdep.h>
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
 #include "note10/exynos_leaf_mapper.h"
+/*
+ * Note10 (v382): 512 MiB XNU window above 4 GiB. The bootstrap map covers
+ * memSize - 0x1004000 = 0x1EFFC000 bytes; exact table preflight
+ * 1 + 16 + 1 + 16 + 2 roots = 36 pages. The pinned header stays unchanged.
+ */
+#undef N10_MAP_POOL_PAGES
+#define N10_MAP_POOL_PAGES 36
 #endif
 #include <arm64/proc_reg.h>
 #include <pexpert/arm64/board_config.h>
@@ -904,14 +911,14 @@ arm_init_tramp:
 
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
 /*
- * Note10 (v378): the loader passes boot_args memSize 0x4000000 (the whole
- * 64 MiB window), so the bootstrap map covers memSize - 0x1004000 = 0x2FFC000
- * bytes from the image. Raise the mapper's size bound from 32 MiB to 48 MiB
- * for the mapper body only (one movz; the pinned exynos_leaf_mapper.h/.S are
- * unchanged). Table preflight: 1 + 2 + 1 + 2 + 2 roots = 8 <= 10 pool pages.
+ * Note10 (v382): the loader passes boot_args memSize 0x20000000 (the whole
+ * 512 MiB window above 4 GiB), so the bootstrap map covers memSize - 0x1004000
+ * = 0x1EFFC000 bytes from the image. Mapper size bound 0x1F000000 (one movz;
+ * the pinned exynos_leaf_mapper.h/.S are unchanged). Table preflight:
+ * 1 + 16 + 1 + 16 + 2 roots = 36 = N10_MAP_POOL_PAGES (set above).
  */
 #undef N10_MAP_MAX_BYTES
-#define N10_MAP_MAX_BYTES 50331648
+#define N10_MAP_MAX_BYTES 520093696
 #include "note10/exynos_leaf_mapper.S"
 #endif
 
