-
-	const uint32_t *src = (const uint32_t *)md->getBytesNoCopy();
 	uint32_t hash = n10_disp_sample((const uint8_t *)src, bpr), bad = 0;
 	if (n10_disp_otf) {                             /* v400 map=otf */
 		bad = n10_disp_copy_otf(src, bpr);
@@ -1793,7 +1845,9 @@ n10_disp_swap(IOExternalMethodArguments *args)
 			n10_disp_put(n10_disp_run[i].off, end < n10_disp_len ? end : n10_disp_len, n10_disp_run[i].va, src, bpr);
