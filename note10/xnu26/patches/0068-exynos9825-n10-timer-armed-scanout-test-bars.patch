+/* v402 thread call: single probe + arm if the SwapEnd path has not taken it, then one frame per tick until SwapEnd. */
+static void
+n10_disp_tick(thread_call_param_t p0, thread_call_param_t p1)
+{
+	static const uint32_t bars[8] = { 0xffffffffu, 0xffffff00u, 0xff00ffffu, 0xff00ff00u, 0xffff00ffu, 0xffff0000u,
+		                          0xff0000ffu, 0xff000000u };     /* BGRA words: A R G B */
+	uint32_t tick = ++n10_disp_ticks, seen, re = 0;
+	uint64_t d, now = mach_absolute_time();
+
+	(void)p0;
+	(void)p1;
+	if (__atomic_exchange_n(&n10_disp_se_once, 1u, __ATOMIC_RELAXED) == 0) {
+		n10_disp_probe("tmr");
+		n10_disp_arm();
+		nanoseconds_to_absolutetime(N10_DISP_RETRY_NS, &d);
+		n10_disp_retry_at = now + d;
+	} else if (n10_disp_retry != 0 && n10_disp_retries < N10_DISP_RETRIES && now >= n10_disp_retry_at && n10_disp_retry_at != 0 &&
+	    !__atomic_load_n(&n10_disp_armed, __ATOMIC_ACQUIRE) && !__atomic_load_n(&n10_disp_se_seen, __ATOMIC_RELAXED)) {
+		/* v402 r2: the timer's own arm was refused for state not ready (before any mapping): probe and arm again */
+		re = ++n10_disp_retries;
+		n10_disp_probe("tmr");
+		n10_disp_arm();
+		nanoseconds_to_absolutetime(N10_DISP_RETRY_NS, &d);
+		n10_disp_retry_at = now + d;
+	}
+	if (n10_disp_bars == NULL) {
+		uint32_t *row = (uint32_t *)IOMalloc(N10_FB_WIDTH * 4u);
+		if (row != NULL) {
+			for (uint32_t x = 0; x < N10_FB_WIDTH; x++) {
+				row[x] = bars[x / (N10_FB_WIDTH / 8u)];
+			}
+			n10_disp_bars = row;
+		}
+	}
+	seen = __atomic_load_n(&n10_disp_se_seen, __ATOMIC_RELAXED);
+	if (seen == 0) {
+		n10_disp_frame(0, 1);
+	}
+	if (tick <= 4u || (tick & 7u) == 0 || re != 0 || seen != 0 || tick >= N10_DISP_TMR_TICKS) {
+		n10_dsslog_trace("N402T tick=%u armed=%u se=%u copies=%u frames=%u fails=%u re=%u", tick,
+		    __atomic_load_n(&n10_disp_armed, __ATOMIC_RELAXED), seen, n10_disp_copies,
+		    __atomic_load_n(&n10_disp_frames, __ATOMIC_RELAXED), __atomic_load_n(&n10_disp_fails, __ATOMIC_RELAXED), re);
+	}
+	if (seen == 0 && tick < N10_DISP_TMR_TICKS) {
+		nanoseconds_to_absolutetime(N10_DISP_TMR_NS, &d);
+		thread_call_enter_delayed(n10_disp_tmr, mach_absolute_time() + d);
+	}
