 	if (n == 1 || (n & 63u) == 0 || bad != 0) {
 		n10_dsslog_trace("N400F copies=%u runs=%u pages=%u bad=%u hash=0x%08x", n, n10_disp_nrun, n10_disp_pages, bad,
