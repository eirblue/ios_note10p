+/*
+ * Note10 (v408): what SpringBoard / backboardd ask IOKit and what they get. v407: SpringBoard's main thread sent
+ * io_registry_create_iterator (0xaf6) to the main device port (port type IKOT_MAIN_DEVICE 37), io_iterator_next
+ * (0xaf2) and io_registry_entry_get_name (0xafa) to 30+ registry objects (IKOT_IOKIT_OBJECT 40),
+ * io_registry_entry_from_path (0xaf9), io_service_get_matching_service_bin (0xb40),
+ * io_service_add_interest_notification_64 (0xb35) and io_service_open_extended (0xb2e) (osfmk/device/device.defs,
+ * subsystem iokit 2800). One "N408I" line per distinct (caller, op, class, name, argument, result):
+ * op i create_iterator (a = plane, v = options), n get_name (<= N10_IOK8_NAMES lines), p get_property,
+ * y get_property_bytes, b get_property_bin(_buf) (v = options), m get_matching_service hit (a = class / name /
+ * resource / first property key of the matching), f from_path hit (a = path), t add_interest_notification
+ * (a = interest type), o open_extended final result (v = connect type). kr = the routine's IOReturn (found/not found).
+ * Log only (no lookup, return value or object changed), at most N10_IOK8_MAX lines per boot.
+ */
+#define N10_IOK8_MAX    192u
+#define N10_IOK8_NAMES  48u
+static uint32_t n10_iok8_lines, n10_iok8_names, n10_iok8_next;
+static uint32_t n10_iok8_seen[N10_IOK8_MAX];
+
+static void
+n10_iok8_note(char op, OSObject *obj, const char *arg, uint64_t val, kern_return_t kr)
+{
+	char name[MAXCOMLEN + 1];
+	IORegistryEntry *re = OSDynamicCast(IORegistryEntry, obj);
+	const char *cls = obj != NULL ? obj->getMetaClass()->getClassName() : "-";
+	const char *nm = re != NULL ? re->getName() : NULL;
+	uint32_t h = 2166136261u;
+
+	if (__atomic_load_n(&n10_iok8_lines, __ATOMIC_RELAXED) >= N10_IOK8_MAX ||
+	    (op == 'n' && __atomic_load_n(&n10_iok8_names, __ATOMIC_RELAXED) >= N10_IOK8_NAMES)) {
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	if (strcmp(name, "SpringBoard") != 0 && strcmp(name, "backboardd") != 0) {
+		return;
+	}
+	nm = nm != NULL ? nm : "";
+	arg = arg != NULL ? arg : "";
+	h = n10_iokit_hash(h, name);
+	h = n10_iokit_hash(h, cls);
+	h = n10_iokit_hash(h, nm);
+	h = n10_iokit_hash(h, arg);
+	h = (h ^ (uint8_t)op) * 16777619u;
+	h = ((h ^ (uint32_t)kr) * 16777619u) | 1u;      /* 0 = free slot */
+	for (uint32_t i = 0; i < N10_IOK8_MAX; i++) {
+		if (__atomic_load_n(&n10_iok8_seen[i], __ATOMIC_RELAXED) == h) {
+			return;
+		}
+	}
+	__atomic_store_n(&n10_iok8_seen[__atomic_fetch_add(&n10_iok8_next, 1u, __ATOMIC_RELAXED) % N10_IOK8_MAX], h,
+	    __ATOMIC_RELAXED);
+	if (__atomic_fetch_add(&n10_iok8_lines, 1u, __ATOMIC_RELAXED) >= N10_IOK8_MAX) {
+		return;
+	}
+	if (op == 'n') {
+		(void)__atomic_fetch_add(&n10_iok8_names, 1u, __ATOMIC_RELAXED);
+	}
+	n10_dsslog_trace("N408I %s %c c=%.32s n=%.28s a=%.60s v=0x%llx kr=0x%x", name, op, cls, nm, arg,
+	    (unsigned long long)val, (unsigned int)kr);
+}
