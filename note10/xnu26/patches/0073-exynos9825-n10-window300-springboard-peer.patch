+/* v407: complex reply to a named request: first descriptor a port -> remember port name -> service name (N407S). */
+static void
+n10_sb_svc_note(const uint8_t *b, int n, const char *svc)
+{
+	uint32_t bits, cnt, pn, w;
+	char line[120];
+	int k, m;
+
+	if (n < 40 || svc[0] == '\0') {
+		return;
+	}
+	memcpy(&bits, b, sizeof(bits));
+	memcpy(&cnt, b + 24, sizeof(cnt));
+	memcpy(&pn, b + 28, sizeof(pn));
+	memcpy(&w, b + 36, sizeof(w));
+	if ((bits & 0x80000000u) == 0 || cnt == 0 || pn == 0 || (w >> 24) != 0u) {    /* MACH_MSGH_BITS_COMPLEX, PORT_DESCRIPTOR */
+		return;
+	}
+	for (k = 0; k < N10_SVC_MAX && n10_svc[k].name != pn; k++) {
+	}
+	if (k < N10_SVC_MAX && strncmp(n10_svc[k].svc, svc, sizeof(n10_svc[k].svc)) == 0) {
+		return;
+	}
+	if (k == N10_SVC_MAX) {
+		k = (int)(n10_svc_next++ % (uint32_t)N10_SVC_MAX);
+	}
+	n10_svc[k].name = pn;
+	memcpy(n10_svc[k].svc, svc, sizeof(n10_svc[k].svc));
+	n10_svc[k].svc[sizeof(n10_svc[k].svc) - 1] = '\0';
+	m = snprintf(line, sizeof(line), "N407S r=0x%x s=%.40s", pn, n10_svc[k].svc);
+	n10_cap_emit(line, m, (int)sizeof(line), &n10_svc_last, &n10_svc_lines, N10_SVC_LINES);
+}
