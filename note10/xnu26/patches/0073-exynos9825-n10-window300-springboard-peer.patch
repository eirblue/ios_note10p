+/* v407: receiver of a SpringBoard send+receive mach_msg2 (N407Q); stored in the slot for N407W. */
+static void
+n10_sb_peer(int i, uint64_t tid, const uint64_t *a)
+{
+	uint64_t opt = a[1];
+	uint32_t rem = (uint32_t)a[3], id = (uint32_t)(a[4] >> 32), ty = 0, h = 2166136261u;
+	const char *svc = "";
+	char comm[17], line[200];
+	int pp = -1, n, k;
+
+	if ((opt & (N10_M64_SEND | N10_M64_RCV)) != (N10_M64_SEND | N10_M64_RCV) || rem == 0) {
+		return;
+	}
+	for (k = 0; k < N10_SVC_MAX; k++) {
+		if (n10_svc[k].name == rem) {
+			svc = n10_svc[k].svc;
+			break;
+		}
+	}
+	if (!n10_port_peer(rem, &pp, comm, (int)sizeof(comm), &ty)) {
+		pp = -1;
+		comm[0] = '-';
+		comm[1] = '\0';
+	}
+	if (i >= 0) {
+		n10_sb[i].ppid = pp;
+		n10_sb[i].pty = ty;
+		memcpy(n10_sb[i].pcomm, comm, sizeof(comm));
+		for (k = 0; k < (int)sizeof(n10_sb[i].svc) - 1 && svc[k] != '\0'; k++) {
+			n10_sb[i].svc[k] = svc[k];
+		}
+		n10_sb[i].svc[k] = '\0';
+	}
+	h = (h ^ rem) * 16777619u;
+	h = (h ^ (uint32_t)pp) * 16777619u;
+	h = (h ^ id) * 16777619u;
+	h = h != 0 ? h : 1u;
+	for (uint32_t q = 0; q < N10_SB_Q_MAX; q++) {
+		if (n10_sb_qseen[q] == h) {
+			return;
+		}
+	}
+	n10_sb_qseen[n10_sb_qnext++ % N10_SB_Q_MAX] = h;
+	n = snprintf(line, sizeof(line), "N407Q t=%llx r=0x%x id=0x%x o=0x%llx p=%d %.16s ty=%u s=%.40s", tid, rem, id, opt, pp,
+	    comm, ty, svc);
+	n10_cap_emit(line, n, (int)sizeof(line), &n10_sb_qlast, &n10_sb_ql, N10_SB_Q_MAX);
+}
