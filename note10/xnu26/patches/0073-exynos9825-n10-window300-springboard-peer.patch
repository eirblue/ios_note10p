+/*
+ * v407: receiver of a send right named in the current task's space (bsd/dev/arm/systemcalls.c N407Q / N407W:
+ * SpringBoard mach_msg2 send+receive calls only, thread context, before the trap runs). ipc_port_translate_send
+ * returns the port locked and active; the receiving space's task pid and p_comm and the port's object type are read,
+ * then the port is unlocked. Read only: no right, reference or port state changes. 1 = resolved; 0 = not a send right
+ * (send-once, dead, invalid) or the port is not in a space (in transit).
+ */
+extern const char *proc_name_address(void *p);
+int n10_port_peer(uint32_t name, int *pid, char *comm, int len, uint32_t *ty);
+
+int
+n10_port_peer(uint32_t name, int *pid, char *comm, int len, uint32_t *ty)
+{
+	ipc_port_t port = IP_NULL;
+	ipc_space_t space;
+	task_t task;
+	void *bp;
+	const char *nm;
+	int k = 0, ok = 0;
+
+	if (name == 0 || pid == NULL || comm == NULL || len <= 1 || ty == NULL ||
+	    ipc_port_translate_send(current_space(), (mach_port_name_t)name, &port) != KERN_SUCCESS) {
+		return 0;
+	}
+	*ty = (uint32_t)ip_type(port);
+	space = ip_get_receiver(port);
+	if (space != NULL) {
+		task = space->is_task;
+		bp = task != TASK_NULL ? get_bsdtask_info(task) : NULL;
+		nm = bp != NULL ? proc_name_address(bp) : NULL;
+		*pid = task != TASK_NULL ? task_pid(task) : -1;
+		for (; nm != NULL && k < len - 1 && nm[k] != '\0'; k++) {
+			comm[k] = nm[k];
+		}
+		ok = 1;
+	}
+	comm[k] = '\0';
+	ip_mq_unlock(port);
+	return ok;
+}
