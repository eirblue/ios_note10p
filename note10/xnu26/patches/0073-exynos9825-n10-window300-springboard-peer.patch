+/* v407: window-end SpringBoard thread lines (N407W), once, from the n10_wdt timer (CPU0) before the deadline. */
+void
+n10_sb_final(void)
+{
+	char line[200];
+	uint64_t mt = 0;
+	uint32_t now = n10_sb_now_ms();
+	int n, m;
+
+	for (int i = 0; i < N10_SB_SLOTS; i++) {
+		if (n10_sb[i].tid != 0 && (mt == 0 || n10_sb[i].tid < mt)) {
+			mt = n10_sb[i].tid;
+		}
+	}
+	for (int i = 0; i < N10_SB_SLOTS; i++) {
+		uint64_t tid = n10_sb[i].tid;
+		if (tid == 0) {
+			continue;
+		}
+		n = snprintf(line, sizeof(line) - 2, "N407W t=%llx m=%u c=%d in=%u o=0x%x r=0x%x id=0x%x p=%d %.16s ty=%u s=%.32s",
+		    tid, tid == mt ? 1u : 0u, n10_sb[i].num, n10_sb[i].in, n10_sb[i].opt, n10_sb[i].rem, n10_sb[i].id,
+		    n10_sb[i].ppid, n10_sb[i].pcomm, n10_sb[i].pty, n10_sb[i].svc[0] != '\0' ? n10_sb[i].svc : n10_sb[i].name);
+		if (n <= 0 || n >= (int)sizeof(line) - 2) {
+			continue;
+		}
+		m = n10_thread_peek(n10_sb[i].th, tid, line + n, (int)sizeof(line) - 2 - n);
+		if (m <= 0) {
+			m = snprintf(line + n, sizeof(line) - 2 - (size_t)n, " gone");
+		}
+		n += m > 0 ? m : 0;
+		if (n < (int)sizeof(line) - 2) {
+			m = snprintf(line + n, sizeof(line) - 2 - (size_t)n, " age=%u", n10_sb[i].in ? now - n10_sb[i].ms : 0u);
+			n += m > 0 ? m : 0;
+		}
+		if (n > (int)sizeof(line) - 2) {
+			n = (int)sizeof(line) - 2;
+		}
+		line[n++] = '\n';
+		n10_dsslog_final(line, n);
+	}
+}
 
