diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 5a76f9e..fcd2772 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -78,6 +78,85 @@ n10_xpc_note(int trap, int num, int err)
 		n10_dsslog_trace("N378Y pid=%d sys=%d err=%d", proc_getpid(p), num, err);
 	}
 }
+
+/*
+ * Note10 (v379): where do the xpcproxy processes wait? One slot per xpcproxy
+ * pid (first N10_XQ_SLOTS pids) holds the BSD syscall (>0) or Mach trap (<0)
+ * it last entered and whether that call has not returned through the
+ * syscall/trap exit path yet. n10_wdt prints the slots once per heartbeat
+ * (N379Q, at most N10_XQ_LINES lines per boot so the shared dss trace budget
+ * keeps room for N376E/N376X). A Mach trap that returns through a continuation
+ * keeps in=1 until the next call. CPU0 only; the timer reader tolerates a torn
+ * slot. Observation only: no return value or state of the call is changed.
+ */
+#define N10_XQ_SLOTS            8
+#define N10_XQ_LINES            192u
+void n10_xpc_enter(int num);
+void n10_xpc_leave(void);
+void n10_xpc_dump(void);
+static struct {
+	int pid;
+	int num;
+	uint32_t in;
+} n10_xq[N10_XQ_SLOTS];
+static uint32_t n10_xq_lines;
+
+static int
+n10_xpc_slot(int alloc)
+{
+	proc_t p = current_proc();
+	int pid, i;
+
+	if (p == PROC_NULL || strncmp(p->p_comm, "xpcproxy", 8) != 0) {
+		return -1;
+	}
+	pid = proc_getpid(p);
+	for (i = 0; i < N10_XQ_SLOTS; i++) {
+		if (n10_xq[i].pid == pid) {
+			return i;
+		}
+		if (n10_xq[i].pid == 0) {
+			if (!alloc) {
+				return -1;
+			}
+			n10_xq[i].pid = pid;
+			return i;
+		}
+	}
+	return -1;
+}
+
+void
+n10_xpc_enter(int num)
+{
+	int i = n10_xpc_slot(1);
+
+	if (i >= 0) {
+		n10_xq[i].num = num;
+		n10_xq[i].in = 1;
+	}
+}
+
+void
+n10_xpc_leave(void)
+{
+	int i = n10_xpc_slot(0);
+
+	if (i >= 0) {
+		n10_xq[i].in = 0;
+	}
+}
+
+void
+n10_xpc_dump(void)
+{
+	for (int i = 0; i < N10_XQ_SLOTS && n10_xq[i].pid != 0; i++) {
+		if (__atomic_fetch_add(&n10_xq_lines, 1u, __ATOMIC_RELAXED) >= N10_XQ_LINES) {
+			return;
+		}
+		n10_dsslog_trace("N379Q pid=%d c=%d in=%u", n10_xq[i].pid, n10_xq[i].num, n10_xq[i].in);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_EXYNOS9825 */
 #define save_r0         r[0]
 #define save_r1         r[1]
@@ -206,9 +285,13 @@ unix_syscall(
 #endif /* CONFIG_DEBUG_SYSCALL_REJECTION */
 
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	n10_xpc_enter(code);
+#endif
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	n10_xpc_leave();
 	if (__improbable(error != 0 && error != ERESTART && error != EJUSTRETURN)) {
 		n10_xpc_note(0, code, error);
 	}
@@ -294,6 +377,7 @@ unix_syscall_return(int error)
 
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	n10_xpc_leave();
 	if (__improbable(error != 0 && error != ERESTART && error != EJUSTRETURN)) {
 		n10_xpc_note(0, code, error);
 	}
