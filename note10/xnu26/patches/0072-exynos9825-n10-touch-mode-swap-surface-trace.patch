@@ -263,6 +275,324 @@ n10_xq_emit(char *line, int n, int cap, uint32_t *last)
 	n10_cap_emit(line, n, cap, last, &n10_xq_lines, N10_XQ_LINES);
 }
 
+/* v406: 1 SpringBoard, 2 backboardd, 0 other (p_comm, exact). */
+static int
+n10_sb_who(proc_t p)
+{
+	if (p == PROC_NULL) {
+		return 0;
+	}
+	if (strncmp(p->p_comm, "SpringBoard", 12) == 0) {
+		return 1;
+	}
+	return strncmp(p->p_comm, "backboardd", 11) == 0 ? 2 : 0;
+}
+
+/*
+ * v406: why does SpringBoard not draw? v405 SpringBoard ran 120 s without an exit, no IOKit miss (N389I covers all
+ * callers) and no logged failure. Per SpringBoard thread (N10_SB_SLOTS slots keyed on the thread id) the BSD syscall
+ * (> 0) or Mach trap (< 0) it is in, since when, and for mach_msg2 the options, remote port, msgh_id and the XPC
+ * "name" string of the message it sent (bootstrap / XPC service name; the serialized dictionary is scanned for the
+ * wire magic and a "name" key of string type, at most N10_SB_BUF bytes copied in from the caller's own buffer).
+ *   N406N  first send of each distinct service name by SpringBoard or backboardd (<= N10_SB_N_MAX)
+ *   N406R  a SpringBoard call that took >= N10_SB_LONG_MS, at its return (end=r) or, when it returned through a
+ *          continuation, at the thread's next call (end=c, duration is then an upper bound) (<= N10_SB_R_MAX)
+ *   N406X  the reply of such a named request carried a non-zero XPC "error" int (<= N10_SB_X_MAX)
+ *   N406T  every 5th heartbeat (~10 s) one line per tracked SpringBoard thread whose state changed (all lines every
+ *          ~40 s): call, in-call flag, port / id / name, n10_thread_peek state, block hint, wait event, pc, age
+ *          (<= N10_SB_T_MAX); a thread found gone frees its slot
+ *   N406F  failing BSD syscalls / Mach traps of SpringBoard (<= N10_SB_F_MAX)
+ * Written with n10_dsslog_write on own caps (outside the shared trace budget, inside the dss area). Observation only:
+ * no argument, return value or state of any call is changed; copyin failures are ignored.
+ */
+#define N10_SB_SLOTS            24
+#define N10_SB_N_MAX            48u
+#define N10_SB_R_MAX            48u
+#define N10_SB_X_MAX            24u
+#define N10_SB_T_MAX            128u
+#define N10_SB_LONG_MS          2000u
+#define N10_SB_BUF              512
+#define N10_M64_SEND            0x1ull                  /* MACH64_SEND_MSG */
+#define N10_M64_RCV             0x2ull                  /* MACH64_RCV_MSG */
+#define N10_M64_VECTOR          0x0000000100000000ull   /* MACH64_MSG_VECTOR */
+void n10_sb_enter(int num, const uint64_t *a);
+void n10_sb_leave(int num, int ret);
+static struct {
+	uint64_t tid;
+	const void *th;
+	uint64_t rcv;
+	int pid;
+	int num;
+	uint32_t in, ms, opt, rem, id, rsz, sum;
+	char name[48];
+} n10_sb[N10_SB_SLOTS];
+static uint32_t n10_sb_nl, n10_sb_rl, n10_sb_xl, n10_sb_tl, n10_sb_dumps;
+static uint32_t n10_sb_nlast, n10_sb_rlast, n10_sb_xlast, n10_sb_nnext;
+static uint32_t n10_sb_seen[N10_SB_N_MAX];
+
+static uint32_t
+n10_sb_now_ms(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+static int
+n10_sb_slot(uint64_t tid, const void *th, int pid, int alloc)
+{
+	for (int i = 0; i < N10_SB_SLOTS; i++) {
+		if (n10_sb[i].tid == tid) {
+			return i;
+		}
+		if (n10_sb[i].tid == 0) {
+			if (!alloc) {
+				return -1;
+			}
+			n10_sb[i].pid = pid;
+			n10_sb[i].th = th;
+			n10_sb[i].in = 0;
+			n10_sb[i].sum = 0;
+			n10_sb[i].tid = tid;
+			return i;
+		}
+	}
+	return -1;
+}
+
+/* Offset of the value after an XPC dictionary key (key incl. NUL, kl bytes) behind the wire magic, or -1. */
+static int
+n10_sb_key(const uint8_t *b, int n, const char *key, int kl)
+{
+	int m = -1;
+
+	for (int i = 0; i + 4 <= n && m < 0; i += 4) {
+		if ((b[i] == 'C' && b[i + 1] == 'P' && b[i + 2] == 'X' && b[i + 3] == '@') ||
+		    (b[i] == '@' && b[i + 1] == 'X' && b[i + 2] == 'P' && b[i + 3] == 'C')) {
+			m = i;
+		}
+	}
+	if (m < 0) {
+		return -1;
+	}
+	for (int i = m + 4; i + kl + 12 <= n; i += 4) {
+		if (memcmp(b + i, key, (size_t)kl) == 0) {
+			return i + ((kl + 3) & ~3);
+		}
+	}
+	return -1;
+}
+
+static int
+n10_sb_copy(uint64_t uaddr, uint32_t size, uint8_t *b)
+{
+	int n = size < N10_SB_BUF ? (int)size : N10_SB_BUF;
+
+	if (uaddr == 0 || n < 32) {
+		return 0;
+	}
+	return copyin((user_addr_t)uaddr, b, (size_t)n) == 0 ? n : 0;
+}
+
+/* The "name" string (type 0x9000) of a serialized XPC message, printable ASCII, or 0. */
+static int
+n10_sb_name(const uint8_t *b, int n, char *out, int cap)
+{
+	int o = n10_sb_key(b, n, "name", 5), k = 0;
+	uint32_t type, len;
+
+	if (o < 0 || o + 8 > n) {
+		return 0;
+	}
+	memcpy(&type, b + o, sizeof(type));
+	memcpy(&len, b + o + 4, sizeof(len));
+	if (type != 0x9000u) {
+		return 0;
+	}
+	for (int i = o + 8; i < n && k < cap - 1 && (uint32_t)k + 1 < len && b[i] != 0; i++) {
+		out[k++] = (b[i] >= 0x20 && b[i] < 0x7f) ? (char)b[i] : '?';
+	}
+	out[k] = '\0';
+	return k;
+}
+
+static void
+n10_sb_msg(int who, int pid, int i, const uint64_t *a)
+{
+	uint64_t opt = a[1], msg = a[0], rcv = a[0], v[3];
+	uint32_t ssz = (uint32_t)(a[2] >> 32), rsz = (uint32_t)a[6], h = 2166136261u;
+	uint8_t b[N10_SB_BUF];
+	char nm[48], line[200];
+	int n;
+
+	if ((opt & N10_M64_VECTOR) != 0) {
+		if (copyin((user_addr_t)a[0], v, sizeof(v)) != 0) {
+			return;
+		}
+		msg = v[0];
+		rcv = v[1] != 0 ? v[1] : v[0];
+		ssz = (uint32_t)v[2];
+		rsz = (uint32_t)(v[2] >> 32);
+	}
+	if (i >= 0) {
+		n10_sb[i].name[0] = '\0';
+		n10_sb[i].rcv = (opt & N10_M64_RCV) != 0 ? rcv : 0;
+		n10_sb[i].rsz = rsz;
+	}
+	if ((opt & N10_M64_SEND) == 0 || (n = n10_sb_copy(msg, ssz, b)) == 0 || n10_sb_name(b, n, nm, (int)sizeof(nm)) == 0) {
+		return;
+	}
+	if (i >= 0) {
+		memcpy(n10_sb[i].name, nm, sizeof(nm));
+	}
+	for (int k = 0; nm[k] != '\0'; k++) {
+		h = (h ^ (uint8_t)nm[k]) * 16777619u;
+	}
+	h = (h ^ (uint32_t)who) * 16777619u;
+	h = h != 0 ? h : 1u;
+	for (uint32_t k = 0; k < N10_SB_N_MAX; k++) {
+		if (n10_sb_seen[k] == h) {
+			return;
+		}
+	}
+	n10_sb_seen[n10_sb_nnext++ % N10_SB_N_MAX] = h;
+	n = snprintf(line, sizeof(line), "N406N %s pid=%d id=0x%x r=0x%x o=0x%llx n=%s", who == 1 ? "sb" : "bbd", pid,
+	    (uint32_t)(a[4] >> 32), (uint32_t)a[3], opt, nm);
+	n10_cap_emit(line, n, (int)sizeof(line), &n10_sb_nlast, &n10_sb_nl, N10_SB_N_MAX);
+}
+
+/* A tracked call ended (end 'r' return, 'c' next call after a continuation return): long-wait and reply lines. */
+static void
+n10_sb_end(int i, uint32_t dur, int ret, char end)
+{
+	uint8_t b[N10_SB_BUF];
+	char line[200];
+	uint32_t type;
+	int64_t err;
+	int n, o;
+
+	n10_sb[i].in = 0;
+	if (dur >= N10_SB_LONG_MS) {
+		n = snprintf(line, sizeof(line), "N406R t=%llx c=%d ret=0x%x ms=%u end=%c o=0x%x r=0x%x id=0x%x n=%.40s",
+		    n10_sb[i].tid, n10_sb[i].num, ret, dur, end, n10_sb[i].opt, n10_sb[i].rem, n10_sb[i].id, n10_sb[i].name);
+		n10_cap_emit(line, n, (int)sizeof(line), &n10_sb_rlast, &n10_sb_rl, N10_SB_R_MAX);
+	}
+	if (n10_sb[i].rcv == 0 || n10_sb[i].name[0] == '\0' || ret != 0) {
+		n10_sb[i].rcv = 0;
+		return;
+	}
+	n = n10_sb_copy(n10_sb[i].rcv, n10_sb[i].rsz, b);
+	n10_sb[i].rcv = 0;
+	o = n > 0 ? n10_sb_key(b, n, "error", 6) : -1;
+	if (o < 0 || o + 12 > n) {
+		return;
+	}
+	memcpy(&type, b + o, sizeof(type));
+	memcpy(&err, b + o + 4, sizeof(err));
+	if ((type != 0x3000u && type != 0x4000u) || err == 0) {
+		return;
+	}
+	n = snprintf(line, sizeof(line), "N406X t=%llx err=%lld ms=%u end=%c n=%.40s", n10_sb[i].tid, err, dur, end,
+	    n10_sb[i].name);
+	n10_cap_emit(line, n, (int)sizeof(line), &n10_sb_xlast, &n10_sb_xl, N10_SB_X_MAX);
+}
+
+void
+n10_sb_enter(int num, const uint64_t *a)
+{
+	proc_t p = current_proc();
+	int who = n10_sb_who(p), i = -1, pid;
+
+	if (who == 0) {
+		return;
+	}
+	pid = proc_getpid(p);
+	if (who == 1) {
+		thread_t th = current_thread();
+		uint32_t now = n10_sb_now_ms();
+
+		i = n10_sb_slot(thread_tid(th), th, pid, 1);
+		if (i >= 0) {
+			if (n10_sb[i].in) {
+				n10_sb_end(i, now - n10_sb[i].ms, 0, 'c');
+			}
+			n10_sb[i].num = num;
+			n10_sb[i].ms = now;
+			n10_sb[i].opt = num == N10_XQ_MSG2 && a != NULL ? (uint32_t)a[1] : 0;
+			n10_sb[i].rem = num == N10_XQ_MSG2 && a != NULL ? (uint32_t)a[3] : 0;
+			n10_sb[i].id = num == N10_XQ_MSG2 && a != NULL ? (uint32_t)(a[4] >> 32) : 0;
+			n10_sb[i].rcv = 0;
+			n10_sb[i].name[0] = '\0';
+			n10_sb[i].in = 1;
+		}
+	}
+	if (num == N10_XQ_MSG2 && a != NULL) {
+		n10_sb_msg(who, pid, i, a);
+	}
+}
+
+void
+n10_sb_leave(int num, int ret)
+{
+	int i;
+
+	(void)num;
+	if (n10_sb_who(current_proc()) != 1 || (i = n10_sb_slot(thread_tid(current_thread()), NULL, 0, 0)) < 0 ||
+	    !n10_sb[i].in) {
+		return;
+	}
+	n10_sb_end(i, n10_sb_now_ms() - n10_sb[i].ms, ret, 'r');
+}
+
+static void
+n10_sb_dump(void)
+{
+	char line[240];
+	uint32_t now, full, sum, last;
+	int n, m;
+
+	if ((n10_sb_dumps++ % 5u) != 0) {
+		return;
+	}
+	full = (n10_sb_dumps / 5u) % 4u == 1u;
+	now = n10_sb_now_ms();
+	for (int i = 0; i < N10_SB_SLOTS; i++) {
+		uint64_t tid = n10_sb[i].tid;
+		if (tid == 0) {
+			continue;
+		}
+		n = snprintf(line, sizeof(line), "N406T t=%llx c=%d in=%u o=0x%x r=0x%x id=0x%x n=%.32s", tid, n10_sb[i].num,
+		    n10_sb[i].in, n10_sb[i].opt, n10_sb[i].rem, n10_sb[i].id, n10_sb[i].name);
+		if (n <= 0 || n >= (int)sizeof(line) - 1) {
+			continue;
+		}
+		m = n10_thread_peek(n10_sb[i].th, tid, line + n, (int)sizeof(line) - n);
+		int gone = m <= 0;
+		if (gone) {
+			m = snprintf(line + n, sizeof(line) - (size_t)n, " gone");
+		}
+		n += m > 0 ? m : 0;
+		sum = 2166136261u;
+		for (int k = 0; k < n && k < (int)sizeof(line); k++) {
+			sum = (sum ^ (uint8_t)line[k]) * 16777619u;
+		}
+		if (gone) {
+			n10_sb[i].tid = 0;          /* free the slot (also when the line is not printed) */
+		} else if (sum == n10_sb[i].sum && !full) {
+			continue;
+		}
+		n10_sb[i].sum = sum;
+		if (n < (int)sizeof(line) - 1) {
+			m = snprintf(line + n, sizeof(line) - (size_t)n, " age=%u", n10_sb[i].in ? now - n10_sb[i].ms : 0u);
+			n += m > 0 ? m : 0;
+		}
+		last = 0;
+		n10_cap_emit(line, n, (int)sizeof(line), &last, &n10_sb_tl, N10_SB_T_MAX);
+	}
+}
+
+
 void
 n10_xpc_dump(void)
 {
@@ -308,6 +638,7 @@ n10_xpc_dump(void)
 	if (n > 0) {
 		n10_cap_emit(line, n, (int)sizeof(line), &n10_fb_dsum, &n10_fb_dumps, N10_FB_DUMPS);
 	}
+	n10_sb_dump();                                  /* v406 N406T */
 }
 #endif /* ARM64_BOARD_CONFIG_EXYNOS9825 */
 #define save_r0         r[0]
@@ -439,11 +770,13 @@ unix_syscall(
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
 	n10_xpc_enter(code, uthread->uu_arg[0], uthread->uu_arg[1], 0);       /* v386: arg0/arg1 for N386B */
+	n10_sb_enter(code, NULL);                       /* v406: SpringBoard wait trace */
 #endif
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
 	n10_xpc_leave(code, error);
+	n10_sb_leave(code, error);
 	if (__improbable(error != 0 && error != ERESTART && error != EJUSTRETURN)) {
 		n10_xpc_note(0, code, error);
 	}
@@ -530,6 +863,7 @@ unix_syscall_return(int error)
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
 	n10_xpc_leave(code, error);
+	n10_sb_leave(code, error);
 	if (__improbable(error != 0 && error != ERESTART && error != EJUSTRETURN)) {
 		n10_xpc_note(0, code, error);
 	}
