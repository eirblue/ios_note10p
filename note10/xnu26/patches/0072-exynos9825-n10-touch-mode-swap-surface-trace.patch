diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 498b409..664fecf 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -66,6 +66,11 @@ static uint32_t n10_xpc_lines;
 static uint32_t n10_bbd_lines;
 #define N10_CMD_MAX             64u
 static uint32_t n10_cmd_lines;
+/* v406: SpringBoard failing calls (N406F) on their own cap; helpers defined below. */
+#define N10_SB_F_MAX            48u
+static uint32_t n10_sb_fl, n10_sb_flast;
+static void n10_cap_emit(char *line, int n, int cap, uint32_t *last, uint32_t *count, uint32_t max);
+static int n10_sb_who(proc_t p);
 
 void
 n10_xpc_note(int trap, int num, int err)
@@ -75,6 +80,13 @@ n10_xpc_note(int trap, int num, int err)
