 /* osfmk/arm64/note10/n10_dsslog.c (v376): one bounded line into the dss log ring. */
 extern void n10_dsslog_trace(const char *fmt, ...) __printflike(1, 2);
+struct vm_shared_region;
+extern struct vm_shared_region *vm_shared_region_get(struct task *task);
+extern kern_return_t vm_shared_region_start_address(struct vm_shared_region *shared_region,
+    mach_vm_offset_t *start_address);
+extern void vm_shared_region_deallocate(struct vm_shared_region *shared_region);
+
+/*
+ * Note10 (v383): for a crash signal taken by the exiting thread itself
+ * (abort, fault, trap), one "N383A" line with the user PC and up to six
+ * frame-pointer return addresses plus the slid shared-cache start, so the
+ * host can symbolize where SpringBoard/backboardd/mediaserverd died.
+ */
+static void
+n10_exit_frames(proc_t p, int sig)
+{
+	uintptr_t bt[7] = { 0 };
+	struct backtrace_user_info info = BTUINFO_INIT;
+	struct vm_shared_region *sr;
+	mach_vm_offset_t sc = 0;
+	unsigned int n;
+
+	if (sig != SIGABRT && sig != SIGSEGV && sig != SIGBUS && sig != SIGILL &&
+	    sig != SIGTRAP && sig != SIGFPE) {
+		return;
+	}
+	n = backtrace_user(bt, 7, NULL, &info);
+	sr = vm_shared_region_get(current_task());
+	if (sr != NULL) {
+		if (vm_shared_region_start_address(sr, &sc) != KERN_SUCCESS) {
+			sc = 0;
+		}
+		vm_shared_region_deallocate(sr);
+	}
+	n10_dsslog_trace("N383A pid=%d sig=%d n=%u pc=%lx f=%lx,%lx,%lx,%lx,%lx,%lx sc=%llx",
+	    proc_getpid(p), sig, n, bt[0], bt[1], bt[2], bt[3], bt[4], bt[5], bt[6],
+	    (unsigned long long)sc);
+}
