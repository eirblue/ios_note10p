diff --git a/bsd/pthread/n10_psynch.c b/bsd/pthread/n10_psynch.c
new file mode 100644
index 0000000..bf3ce8e
--- /dev/null
+++ b/bsd/pthread/n10_psynch.c
@@ -0,0 +1,397 @@
+/*
+ * Copyright (c) 2026 Apple Inc. All rights reserved.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ *
+ * This file contains Original Code and/or Modifications of Original Code
+ * as defined in and that are subject to the Apple Public Source License
+ * Version 2.0 (the 'License'). You may not use this file except in
+ * compliance with the License. The rights granted to you under the License
+ * may not be used to create, or enable the creation or redistribution of,
+ * unlawful or unlicensed forms of the Original Code.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+
+/*
+ * Note10 (v383): built-in psynch for the iOS 16 userland.
+ *
+ * The pthread kext is not part of this kernel; pthread_functions is a static
+ * table whose psynch slots are brk sleds, so the first contended
+ * pthread_cond_wait (v382: sleepd, psynch_cvwait, brk #0x7014) stopped the
+ * kernel with IRQs masked. This file implements the condition-variable and
+ * first-fit mutex calls on the libpthread sequence words, without the
+ * kext's prepost/handoff machinery:
+ *
+ * cv waiter   ordinal = its own L (cvlsgen low word). It returns PTHRW_INC on
+ *             wakeup, so userland adds exactly one to S per departed waiter
+ *             (errors add one in userland). cvsignal/cvbroad return 0.
+ * cvsignal    releases the oldest sleeper whose ordinal <= the signal's L;
+ *             with no such sleeper it leaves one credit (bounded by the
+ *             pending L - S) for a waiter still on its way into the kernel.
+ * cvbroad     releases every sleeper with ordinal <= L and leaves credits for
+ *             the pending waiters that are not asleep yet.
+ * mutexwait   (first-fit: the woken thread retries in userland) sleeps unless
+ *             a drop left a credit.
+ * mutexdrop   releases the oldest sleeper or leaves one credit: each drop
+ *             answers one waiter registered in L, so none is lost.
+ *
+ * An arriving waiter takes any credit: the wake calls can reach the kernel
+ * out of order, so credits are counted, not matched to sequence numbers.
+ * The number of wakeups equals the number of signals/drops; an extra one is
+ * a spurious wakeup, which POSIX allows and libpthread handles. One global mutex
+ * (num_cpus == 1 on this platform). Objects are keyed by (proc, address,
+ * kind), referenced by the calls using them and freed when idle;
+ * pth_proc_hashdelete purges the rest.
+ * Limits: process-shared objects are keyed per process; targeted
+ * pthread_cond_signal_thread_np wakes any eligible waiter; rwlocks
+ * (handoff protocol) are refused with ENOTSUP and one N383P line.
+ */
+
+#include <stdbool.h>
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <sys/proc_internal.h>
+#include <sys/queue.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <kern/zalloc.h>
+
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+
+/* osfmk/arm64/note10/n10_dsslog.c (v376): one bounded line into the dss log ring. */
+extern void n10_dsslog_trace(const char *fmt, ...) __printflike(1, 2);
+
+/* called from the psynch shims in bsd/pthread/pthread_shims.c */
+int n10_psynch_mutexwait(proc_t, user_addr_t, uint32_t, uint32_t, uint64_t, uint32_t, uint32_t *);
+int n10_psynch_mutexdrop(proc_t, user_addr_t, uint32_t, uint32_t, uint64_t, uint32_t, uint32_t *);
+int n10_psynch_cvwait(proc_t, user_addr_t, uint64_t, uint32_t, user_addr_t, uint64_t, uint32_t,
+    int64_t, uint32_t, uint32_t *);
+int n10_psynch_cvsignal(proc_t, user_addr_t, uint64_t, uint32_t, int, user_addr_t, uint64_t, uint64_t,
+    uint32_t, uint32_t *);
+int n10_psynch_cvbroad(proc_t, user_addr_t, uint64_t, uint64_t, uint32_t, user_addr_t, uint64_t, uint64_t,
+    uint32_t *);
+int n10_psynch_cvclrprepost(proc_t, user_addr_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t,
+    int *);
+int n10_psynch_rw_refuse(proc_t, const char *, user_addr_t, uint32_t, uint32_t);
+void n10_psynch_proc_purge(proc_t);
+
+#define N10_PS_INC              0x100u
+#define N10_PS_COUNT            0xffffff00u
+#define N10_PS_BUCKETS          64u
+#define N10_PS_MAX_SEC          100000000ll
+#define N10_PS_RW_LINES         32u
+
+enum { N10_PS_MUTEX = 1, N10_PS_CV = 2 };
+
+struct n10_ps_waiter {
+	TAILQ_ENTRY(n10_ps_waiter) link;
+	uint32_t                ord;    /* cv: own L */
+	int                     released;
+};
+
+struct n10_ps_obj {
+	LIST_ENTRY(n10_ps_obj)  link;
+	TAILQ_HEAD(, n10_ps_waiter) waiters;
+	proc_t                  p;
+	user_addr_t             addr;
+	uint32_t                kind;
+	uint32_t                refs;           /* calls currently using the object */
+	uint32_t                credits;        /* wakeups not delivered to a sleeper */
+};
+
+static LIST_HEAD(, n10_ps_obj) n10_ps_hash[N10_PS_BUCKETS];
+static LCK_GRP_DECLARE(n10_ps_grp, "n10_psynch");
+static LCK_MTX_DECLARE(n10_ps_lock, &n10_ps_grp);
+static uint32_t n10_ps_rw_lines;
+
+/* a <= b on the 24-bit sequence counts (wrap aware) */
+static inline bool
+n10_ps_le(uint32_t a, uint32_t b)
+{
+	return (int32_t)((b & N10_PS_COUNT) - (a & N10_PS_COUNT)) >= 0;
+}
+
+/* waiters counted by hi - lo, 0 when not ahead */
+static inline uint32_t
+n10_ps_pending(uint32_t hi, uint32_t lo)
+{
+	int32_t d = (int32_t)((hi & N10_PS_COUNT) - (lo & N10_PS_COUNT));
+
+	return d > 0 ? (uint32_t)d >> 8 : 0;
+}
+
+static inline uint32_t
+n10_ps_bucket(proc_t p, user_addr_t addr)
+{
+	return (uint32_t)(((uintptr_t)p >> 4) ^ (addr >> 3)) % N10_PS_BUCKETS;
+}
+
+static struct n10_ps_obj *
+n10_ps_lookup(proc_t p, user_addr_t addr, uint32_t kind, bool create)
+{
+	struct n10_ps_obj *o;
+	uint32_t b = n10_ps_bucket(p, addr);
+
+	LIST_FOREACH(o, &n10_ps_hash[b], link) {
+		if (o->p == p && o->addr == addr && o->kind == kind) {
+			o->refs++;
+			return o;
+		}
+	}
+	if (!create) {
+		return NULL;
+	}
+	o = kalloc_type(struct n10_ps_obj, Z_WAITOK | Z_ZERO | Z_NOFAIL);
+	TAILQ_INIT(&o->waiters);
+	o->p = p;
+	o->addr = addr;
+	o->kind = kind;
+	o->refs = 1;
+	LIST_INSERT_HEAD(&n10_ps_hash[b], o, link);
+	return o;
+}
+
+static void
+n10_ps_release(struct n10_ps_obj *o)
+{
+	if (--o->refs == 0 && TAILQ_EMPTY(&o->waiters) && o->credits == 0) {
+		LIST_REMOVE(o, link);
+		kfree_type(struct n10_ps_obj, o);
+	}
+}
+
+static void
+n10_ps_wake(struct n10_ps_obj *o, struct n10_ps_waiter *w)
+{
+	TAILQ_REMOVE(&o->waiters, w, link);
+	w->released = 1;
+	thread_wakeup((event_t)w);
+}
+
+/* Sleep on w (queued on o) until released, timed out or interrupted. Lock held. */
+static int
+n10_ps_sleep(struct n10_ps_obj *o, struct n10_ps_waiter *w, uint64_t deadline)
+{
+	wait_result_t wr;
+	int error = 0;
+
+	TAILQ_INSERT_TAIL(&o->waiters, w, link);
+	while (!w->released) {
+		if (deadline != 0) {
+			wr = lck_mtx_sleep_deadline(&n10_ps_lock, LCK_SLEEP_DEFAULT, (event_t)w,
+			    THREAD_ABORTSAFE, deadline);
+		} else {
+			wr = lck_mtx_sleep(&n10_ps_lock, LCK_SLEEP_DEFAULT, (event_t)w, THREAD_ABORTSAFE);
+		}
+		if (w->released) {
+			break;
+		}
+		if (wr == THREAD_TIMED_OUT) {
+			error = ETIMEDOUT;
+			break;
+		}
+		if (wr == THREAD_INTERRUPTED || wr == THREAD_RESTART) {
+			error = EINTR;
+			break;
+		}
+	}
+	if (!w->released) {
+		TAILQ_REMOVE(&o->waiters, w, link);
+	}
+	return w->released ? 0 : error;
+}
+
+/* First-fit mutex drop: wake the oldest sleeper or leave one credit. Lock held. */
+static void
+n10_ps_mutex_drop_locked(proc_t p, user_addr_t mutex)
+{
+	struct n10_ps_obj *o = n10_ps_lookup(p, mutex, N10_PS_MUTEX, true);
+	struct n10_ps_waiter *w = TAILQ_FIRST(&o->waiters);
+
+	if (w != NULL) {
+		n10_ps_wake(o, w);
+	} else {
+		/* every drop answers one waiter registered in L: keep each undelivered one */
+		o->credits++;
+	}
+	n10_ps_release(o);
+}
+
+int
+n10_psynch_mutexwait(proc_t p, user_addr_t mutex, uint32_t mgen __unused, uint32_t ugen __unused,
+    uint64_t tid __unused, uint32_t flags __unused, uint32_t *retval)
+{
+	struct n10_ps_waiter w = { .ord = 0 };
+	struct n10_ps_obj *o;
+	int error = 0;
+
+	lck_mtx_lock(&n10_ps_lock);
+	o = n10_ps_lookup(p, mutex, N10_PS_MUTEX, true);
+	if (o->credits != 0) {
+		o->credits--;
+	} else {
+		error = n10_ps_sleep(o, &w, 0);
+	}
+	n10_ps_release(o);
+	lck_mtx_unlock(&n10_ps_lock);
+	*retval = 0;
+	return error;
+}
+
+int
+n10_psynch_mutexdrop(proc_t p, user_addr_t mutex, uint32_t mgen __unused, uint32_t ugen __unused,
+    uint64_t tid __unused, uint32_t flags __unused, uint32_t *retval)
+{
+	lck_mtx_lock(&n10_ps_lock);
+	n10_ps_mutex_drop_locked(p, mutex);
+	lck_mtx_unlock(&n10_ps_lock);
+	*retval = 0;
+	return 0;
+}
+
+int
+n10_psynch_cvwait(proc_t p, user_addr_t cv, uint64_t cvlsgen, uint32_t cvugen __unused,
+    user_addr_t mutex, uint64_t mugen __unused, uint32_t flags __unused, int64_t sec, uint32_t nsec,
+    uint32_t *retval)
+{
+	struct n10_ps_waiter w = { .ord = (uint32_t)cvlsgen };
+	struct n10_ps_obj *o;
+	uint64_t deadline = 0;
+	int error = 0;
+
+	/* relative timeout, as the kext reads it (nsec low 30 bits) */
+	nsec &= 0x3fffffffu;
+	if (sec < 0) {
+		return EINVAL;
+	}
+	if (sec != 0 || nsec != 0) {
+		uint64_t abstime;
+
+		nanoseconds_to_absolutetime((uint64_t)MIN(sec, N10_PS_MAX_SEC) * NSEC_PER_SEC + nsec, &abstime);
+		clock_absolutetime_interval_to_deadline(abstime, &deadline);
+	}
+
+	lck_mtx_lock(&n10_ps_lock);
+	if (mutex != 0) {
+		/* userland passed the mutex because it has kernel waiters: drop it here */
+		n10_ps_mutex_drop_locked(p, mutex);
+	}
+	o = n10_ps_lookup(p, cv, N10_PS_CV, true);
+	if (o->credits != 0) {
+		o->credits--;
+	} else {
+		error = n10_ps_sleep(o, &w, deadline);
+	}
+	n10_ps_release(o);
+	lck_mtx_unlock(&n10_ps_lock);
+	if (error == 0) {
+		*retval = N10_PS_INC;
+	}
+	return error;
+}
+
+int
+n10_psynch_cvsignal(proc_t p, user_addr_t cv, uint64_t cvlsgen, uint32_t cvugen __unused,
+    int thread_port __unused, user_addr_t mutex __unused, uint64_t mugen __unused,
+    uint64_t tid __unused, uint32_t flags __unused, uint32_t *retval)
+{
+	uint32_t lgen = (uint32_t)cvlsgen, sgen = (uint32_t)(cvlsgen >> 32);
+	uint32_t pending = n10_ps_pending(lgen, sgen);
+	struct n10_ps_waiter *w;
+	struct n10_ps_obj *o;
+
+	lck_mtx_lock(&n10_ps_lock);
+	o = n10_ps_lookup(p, cv, N10_PS_CV, true);
+	TAILQ_FOREACH(w, &o->waiters, link) {
+		if (n10_ps_le(w->ord, lgen)) {
+			break;
+		}
+	}
+	if (w != NULL) {
+		n10_ps_wake(o, w);
+	} else if (o->credits < pending) {
+		o->credits++;
+	}
+	n10_ps_release(o);
+	lck_mtx_unlock(&n10_ps_lock);
+	*retval = 0;
+	return 0;
+}
+
+int
+n10_psynch_cvbroad(proc_t p, user_addr_t cv, uint64_t cvlsgen, uint64_t cvudgen __unused,
+    uint32_t flags __unused, user_addr_t mutex __unused, uint64_t mugen __unused,
+    uint64_t tid __unused, uint32_t *retval)
+{
+	uint32_t lgen = (uint32_t)cvlsgen, sgen = (uint32_t)(cvlsgen >> 32);
+	uint32_t pending = n10_ps_pending(lgen, sgen), woken = 0;
+	struct n10_ps_waiter *w, *next;
+	struct n10_ps_obj *o;
+
+	lck_mtx_lock(&n10_ps_lock);
+	o = n10_ps_lookup(p, cv, N10_PS_CV, true);
+	TAILQ_FOREACH_SAFE(w, &o->waiters, link, next) {
+		if (n10_ps_le(w->ord, lgen)) {
+			n10_ps_wake(o, w);
+			woken++;
+		}
+	}
+	if (pending > woken) {
+		o->credits = MAX(o->credits, pending - woken);
+	}
+	n10_ps_release(o);
+	lck_mtx_unlock(&n10_ps_lock);
+	*retval = 0;
+	return 0;
+}
+
+int
+n10_psynch_cvclrprepost(proc_t p, user_addr_t cv, uint32_t cvgen __unused, uint32_t cvugen __unused,
+    uint32_t cvsgen __unused, uint32_t prepocnt __unused, uint32_t preposeq __unused,
+    uint32_t flags __unused, int *retval)
+{
+	struct n10_ps_obj *o;
+
+	lck_mtx_lock(&n10_ps_lock);
+	o = n10_ps_lookup(p, cv, N10_PS_CV, false);
+	if (o != NULL) {
+		o->credits = 0;
+		n10_ps_release(o);
+	}
+	lck_mtx_unlock(&n10_ps_lock);
+	*retval = 0;
+	return 0;
+}
+
+int
+n10_psynch_rw_refuse(proc_t p, const char *op, user_addr_t rwlock, uint32_t lgenval, uint32_t ugenval)
+{
+	if (__atomic_fetch_add(&n10_ps_rw_lines, 1u, __ATOMIC_RELAXED) < N10_PS_RW_LINES) {
+		n10_dsslog_trace("N383P rw %s pid=%d %s lock=0x%llx l=0x%x u=0x%x ENOTSUP", op, proc_getpid(p),
+		    p->p_comm, (unsigned long long)rwlock, lgenval, ugenval);
+	}
+	return ENOTSUP;
+}
+
+void
+n10_psynch_proc_purge(proc_t p)
+{
+	struct n10_ps_obj *o, *next;
+
+	lck_mtx_lock(&n10_ps_lock);
+	for (uint32_t b = 0; b < N10_PS_BUCKETS; b++) {
+		LIST_FOREACH_SAFE(o, &n10_ps_hash[b], link, next) {
+			if (o->p == p && o->refs == 0) {
+				LIST_REMOVE(o, link);
+				kfree_type(struct n10_ps_obj, o);
+			}
+		}
+	}
+	lck_mtx_unlock(&n10_ps_lock);
+}
+
+#endif /* ARM64_BOARD_CONFIG_EXYNOS9825 */
diff --git a/bsd/pthread/pthread_shims.c b/bsd/pthread/pthread_shims.c
index e5e58b5..9cfbb37 100644
--- a/bsd/pthread/pthread_shims.c
+++ b/bsd/pthread/pthread_shims.c
@@ -321,6 +321,25 @@ pthread_init(void)
 	pthread_functions->pthread_init();
 }
 
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+/*
+ * Note10 (v383): bsd/pthread/n10_psynch.c implements the psynch calls; the
+ * pthread kext is absent and the static table's psynch slots are brk sleds.
+ */
+extern int n10_psynch_mutexwait(proc_t, user_addr_t, uint32_t, uint32_t, uint64_t, uint32_t, uint32_t *);
