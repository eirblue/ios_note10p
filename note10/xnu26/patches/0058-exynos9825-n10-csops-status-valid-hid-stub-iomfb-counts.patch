+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+		/*
+		 * Note10 (v392): with AMFI absent CS_VALID/CS_SIGNED are never set, so
+		 * containermanagerd refused every client ("Client pid [%d] is not
+		 * signed or has died.", error 98) before reading its entitlements:
+		 * backboardd's system container path came back nil (NSURL abort in
+		 * StartWindowServer), lsd and aggregated failed the same way. Report
+		 * a process whose executable carries an embedded signature as signed
+		 * and valid in this answer only; its csflags are not changed.
+		 */
+		if (amfi == NULL && pt->p_textvp != NULLVP &&
+		    ubc_cs_blob_get(pt->p_textvp, -1, -1, pt->p_textoff) != NULL) {
+			retflags |= CS_VALID | CS_SIGNED;
+			n10_status_sig = true;
+		}
+#endif
 		proc_unlock(pt);
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+		if (n10_status_sig && n10_status_trace_ok(proc_getpid(current_proc()), proc_getpid(pt))) {
+			n10_dsslog_trace("N392C %s op=0 pid=%d %s flags=0x%x", current_proc()->p_comm,
+			    proc_getpid(pt), pt->p_comm, retflags);
+		}
