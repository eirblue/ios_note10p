+/*
+ * N392C line budget (v392): one line per CS_OPS_STATUS answer that the
+ * embedded-signature rule marked signed and valid, only for a query on another
+ * process by a caller other than launchd, at most N10_STATUS_CROSS lines.
+ */
+#define N10_STATUS_CROSS        32u
+static uint32_t n10_status_lines;
+
+static bool
+n10_status_trace_ok(pid_t caller, pid_t target)
+{
+	return caller != 1 && caller != target &&
+	       __atomic_fetch_add(&n10_status_lines, 1u, __ATOMIC_RELAXED) < N10_STATUS_CROSS;
+}
+
 /*
  * Note10 (v390): AMFI is not loaded and CS_SIGNED/CS_VALID are never set on
  * this port, so every entitlement and identity query of csops failed with
@@ -3892,6 +3907,9 @@ csops_internal(pid_t pid, int ops, user_addr_t uaddr, user_size_t usersize, user
 	switch (ops) {
 	case CS_OPS_STATUS: {
 		uint32_t retflags;
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+		bool n10_status_sig = false;
+#endif
 
 		proc_lock(pt);
 		retflags = (uint32_t)proc_getcsflags(pt);
@@ -3908,7 +3926,29 @@ csops_internal(pid_t pid, int ops, user_addr_t uaddr, user_size_t usersize, user
 		if ((proc_getcsflags(pt) & CS_FORCED_LV) == CS_FORCED_LV) {
 			retflags &= (~CS_REQUIRE_LV);
