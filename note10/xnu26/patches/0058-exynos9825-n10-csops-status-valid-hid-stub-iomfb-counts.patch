diff --git a/iokit/Kernel/NoteFramebuffer.cpp b/iokit/Kernel/NoteFramebuffer.cpp
index 258ac40..cd05d16 100644
--- a/iokit/Kernel/NoteFramebuffer.cpp
+++ b/iokit/Kernel/NoteFramebuffer.cpp
@@ -30,6 +30,23 @@
  * kIOReturnUnsupported. Other selectors succeed with zeroed outputs. The
  * first call of each selector and every open/notification port registration
  * is logged (N391F) into the dss ring.
+ *
+ * v392: v391 showed only IOMFB_FDR_Loader opening the service before the
+ * shared dss trace budget ran out (t = 16.3 s), so whether SpringBoard /
+ * backboardd ever swap was not visible. The user client now counts opens,
+ * notification ports and calls (GetLayerDefaultSurface 3, SwapBegin 4,
+ * SwapEnd 5, SwapWait 6, GetDisplaySize 8, all others) and keeps the name of
+ * the last caller; n10_iomfb_counts() formats them as one "N392F" line that
+ * bsd/dev/arm/systemcalls.c n10_xpc_dump writes at a heartbeat when it changed
+ * (own line cap there). Counting only: answers are unchanged.
+ *
+ * v392 also publishes a HID event service stub: a plain IOService instance
+ * (no new class, so no vtable / metaclass growth of __DATA_CONST, whose tail
+ * holds the chain table caves) on IOResources with HIDServiceSupport = true
+ * (the property backboardd's IOHIDEventSystem matches on, v391 N389I
+ * "c=IOService p=HIDServiceSupport"), a vendor usage pair and no
+ * IOCFPlugInTypes / user client: it carries no events and touches no hardware
+ * (no touch controller, no register, no interrupt). One "N392H" publish line.
  */
 #include <pexpert/arm64/board_config.h>
 
@@ -67,6 +84,56 @@ static uint32_t n10_fb_lines;
 static uint32_t n10_fb_seen[4];                 /* selectors 0..127 already logged */
 static uint32_t n10_fb_swap_id;
 
+/* v392 N392F counters: opens, notification ports, selectors 3/4/5/6/8, others. */
+enum { N10_FB_C_SURF, N10_FB_C_SB, N10_FB_C_SE, N10_FB_C_SW, N10_FB_C_DS, N10_FB_C_OTHER, N10_FB_C_N };
+static uint32_t n10_fb_opens, n10_fb_notifies;
+static uint32_t n10_fb_calls[N10_FB_C_N];
+static char n10_fb_last[17];                    /* last caller (p_comm), single writer races are harmless */
+
+static void
+n10_fb_count(uint32_t selector)
+{
+	int k;
+
+	switch (selector) {
+	case 3: k = N10_FB_C_SURF; break;
+	case 4: k = N10_FB_C_SB; break;
+	case 5: k = N10_FB_C_SE; break;
+	case 6: k = N10_FB_C_SW; break;
+	case 8: k = N10_FB_C_DS; break;
+	default: k = N10_FB_C_OTHER; break;
+	}
+	__atomic_fetch_add(&n10_fb_calls[k], 1u, __ATOMIC_RELAXED);
+	proc_selfname(n10_fb_last, sizeof(n10_fb_last));
+}
+
+/*
+ * One N392F line (no newline) into buf; 0 while the user client was never
+ * opened. Reads the counters only (called from the heartbeat).
+ */
+extern "C" int n10_iomfb_counts(char *buf, int len);
+
+extern "C" int
+n10_iomfb_counts(char *buf, int len)
+{
+	uint32_t opens = __atomic_load_n(&n10_fb_opens, __ATOMIC_RELAXED);
+	char last[17];
+
+	if (opens == 0 || len <= 0) {
+		return 0;
+	}
+	memcpy(last, n10_fb_last, sizeof(last));
+	last[sizeof(last) - 1] = '\0';
+	return snprintf(buf, (size_t)len, "N392F op=%u nt=%u surf=%u sb=%u se=%u sw=%u ds=%u oth=%u last=%.16s",
+	    opens, __atomic_load_n(&n10_fb_notifies, __ATOMIC_RELAXED),
+	    __atomic_load_n(&n10_fb_calls[N10_FB_C_SURF], __ATOMIC_RELAXED),
+	    __atomic_load_n(&n10_fb_calls[N10_FB_C_SB], __ATOMIC_RELAXED),
+	    __atomic_load_n(&n10_fb_calls[N10_FB_C_SE], __ATOMIC_RELAXED),
+	    __atomic_load_n(&n10_fb_calls[N10_FB_C_SW], __ATOMIC_RELAXED),
+	    __atomic_load_n(&n10_fb_calls[N10_FB_C_DS], __ATOMIC_RELAXED),
+	    __atomic_load_n(&n10_fb_calls[N10_FB_C_OTHER], __ATOMIC_RELAXED), last);
+}
+
 static bool
 n10_fb_trace_ok(uint32_t selector)
 {
@@ -126,6 +193,7 @@ IOMobileFramebufferUserClient::start(IOService *provider)
 		return false;
 	}
 	notifyPort = NULL;
+	__atomic_fetch_add(&n10_fb_opens, 1u, __ATOMIC_RELAXED);
 	if (__atomic_fetch_add(&n10_fb_lines, 1u, __ATOMIC_RELAXED) < N10_FB_LINES) {
 		char name[32];
 		proc_selfname(name, sizeof(name));
@@ -153,6 +221,7 @@ IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, UInt32
 		releaseNotificationPort(notifyPort);
 	}
 	notifyPort = port;
+	__atomic_fetch_add(&n10_fb_notifies, 1u, __ATOMIC_RELAXED);
 	if (__atomic_fetch_add(&n10_fb_lines, 1u, __ATOMIC_RELAXED) < N10_FB_LINES) {
 		char name[32];
 		proc_selfname(name, sizeof(name));
@@ -231,6 +300,7 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 		break;
 	}
 
+	n10_fb_count(selector);
 	if (n10_fb_trace_ok(selector)) {
 		char name[32];
 		proc_selfname(name, sizeof(name));
@@ -310,6 +380,28 @@ n10_iomfb_publish(void)
 
 	n10_dsslog_trace("N391F publish arm-io=%d disp=%d fb=%d %ux%u", armio_state, (int)disp, (int)fb_ok,
 	    N10_FB_WIDTH, N10_FB_HEIGHT);
+
+	/*
+	 * v392 HID event service stub (IOProviderClass IOService + HIDServiceSupport
+	 * match of backboardd's IOHIDEventSystem): plain IOService, registry only.
+	 */
+	bool hid_ok = false;
+	IOService *hid = OSTypeAlloc(IOService);
+	if (hid != NULL && resources != NULL && hid->init() && hid->attach(resources)) {
+		hid->setName("NoteHIDEventService");
+		hid->setProperty("HIDServiceSupport", true);
+		hid->setProperty("PrimaryUsagePage", 0xff00u, 32);   /* vendor-defined: no event processor expects events */
+		hid->setProperty("PrimaryUsage", 1u, 32);
+		hid->setProperty("Product", "Note10 HID stub");
+		hid_ok = hid->start(resources);
+		if (hid_ok) {
+			hid->registerService();
+		} else {
+			hid->detach(resources);
+		}
+	}
+	OSSafeReleaseNULL(hid);
+	n10_dsslog_trace("N392H publish hid=%d HIDServiceSupport", (int)hid_ok);
 }
 
