+/*
+ * v411: who uses CPU0. n10_cpu_sample() runs in the 250 ms watchdog timer interrupt (osfmk/arm64/note10/n10_wdt.c,
+ * after a guarded pet; CPU0 only, so never concurrent with itself or with n10_sb_final) and counts the interrupted
+ * thread's pid (0 = kernel_task, including idle) in N10_CPU_SLOTS slots (first come; further pids add to o=).
+ *   N411C  window-end: samples n, overflow o, v411 priority-floor applications b (osfmk/kern/thread_policy.c), then
+ *          the N10_CPU_TOP most sampled pid:p_comm:count, two lines
+ * Observation only.
+ */
+#define N10_CPU_SLOTS           64
+#define N10_CPU_TOP             16
+static struct {
+	int pid;
+	uint32_t n;
+	char comm[17];
+} n10_cpu[N10_CPU_SLOTS];
+static uint32_t n10_cpu_n, n10_cpu_o;
+extern uint32_t n10_prio_floor_hits;
+extern void n10_dsslog_final(const char *s, int n);
+void n10_cpu_sample(void);
+
+void
+n10_cpu_sample(void)
+{
+	proc_t p = current_proc();
+	int pid = p != PROC_NULL ? proc_getpid(p) : -1;
+	int fr = -1;
+
+	n10_cpu_n++;
+	for (int i = 0; i < N10_CPU_SLOTS; i++) {
+		if (n10_cpu[i].n != 0 && n10_cpu[i].pid == pid) {
+			n10_cpu[i].n++;
+			return;
+		}
+		if (fr < 0 && n10_cpu[i].n == 0) {
+			fr = i;
+		}
+	}
+	if (fr < 0) {
+		n10_cpu_o++;
+		return;
+	}
+	n10_cpu[fr].pid = pid;
+	n10_cpu[fr].n = 1;
+	for (int k = 0; k < 16; k++) {
+		n10_cpu[fr].comm[k] = p != PROC_NULL ? p->p_comm[k] : '\0';
+		if (n10_cpu[fr].comm[k] == '\0') {
+			break;
+		}
+	}
+	n10_cpu[fr].comm[16] = '\0';
+}
+
+/* v411: window-end N411C (two lines, N10_CPU_TOP entries by count); the slot counts are consumed. */
+static void
+n10_cpu_final(void)
+{
+	char ub[320];
+	int n, m;
+
+	for (int ln = 0; ln < 2; ln++) {
+		n = ln == 0 ? snprintf(ub, sizeof(ub) - 2, "N411C n=%u o=%u b=%u", n10_cpu_n, n10_cpu_o, n10_prio_floor_hits) :
+		    snprintf(ub, sizeof(ub) - 2, "N411C +");
+		if (n <= 0 || n >= (int)sizeof(ub) - 2) {
+			return;
+		}
+		for (int e = 0; e < N10_CPU_TOP / 2; e++) {
+			int best = -1;
+			for (int i = 0; i < N10_CPU_SLOTS; i++) {
+				if (n10_cpu[i].n != 0 && (best < 0 || n10_cpu[i].n > n10_cpu[best].n)) {
+					best = i;
+				}
+			}
+			if (best < 0) {
+				break;
+			}
+			m = snprintf(ub + n, sizeof(ub) - 2 - (size_t)n, " %d:%.16s:%u", n10_cpu[best].pid, n10_cpu[best].comm,
+			    n10_cpu[best].n);
+			n10_cpu[best].n = 0;
+			if (m <= 0 || n + m >= (int)sizeof(ub) - 2) {
+				break;
+			}
+			n += m;
+		}
+		ub[n++] = '\n';
+		n10_dsslog_final(ub, n);
+	}
+}
