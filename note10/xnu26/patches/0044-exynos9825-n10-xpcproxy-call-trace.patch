diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 0906700..5a76f9e 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -51,6 +51,34 @@ static void     arm_prepare_syscall_return(const struct sysent *, struct arm_sav
 static unsigned short arm_get_syscall_number(struct arm_saved_state *);
 static void     arm_trace_unix_syscall(int, struct arm_saved_state *);
 static void     arm_clear_syscall_error(struct arm_saved_state *);
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+/*
+ * Note10 (v378): xpcproxy never reached its exec in v377. Record the first
+ * N10_XPC_MAX failing BSD syscalls (N378Y) and Mach traps (N378T, from
+ * osfmk/arm64/bsd_arm64.c) of processes named "xpcproxy" into the dss ring.
+ * Observation only: no return value or state is changed.
+ */
+#define N10_XPC_MAX             160u
+extern void n10_dsslog_trace(const char *fmt, ...) __printflike(1, 2);
+void n10_xpc_note(int trap, int num, int err);
+static uint32_t n10_xpc_lines;
+
+void
+n10_xpc_note(int trap, int num, int err)
+{
+	proc_t p = current_proc();
+
+	if (p == PROC_NULL || strncmp(p->p_comm, "xpcproxy", 8) != 0 ||
+	    __atomic_fetch_add(&n10_xpc_lines, 1u, __ATOMIC_RELAXED) >= N10_XPC_MAX) {
+		return;
+	}
+	if (trap) {
+		n10_dsslog_trace("N378T pid=%d trap=%d kr=0x%x", proc_getpid(p), num, err);
+	} else {
+		n10_dsslog_trace("N378Y pid=%d sys=%d err=%d", proc_getpid(p), num, err);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_EXYNOS9825 */
 #define save_r0         r[0]
 #define save_r1         r[1]
 #define save_r2         r[2]
@@ -180,6 +208,11 @@ unix_syscall(
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	if (__improbable(error != 0 && error != ERESTART && error != EJUSTRETURN)) {
+		n10_xpc_note(0, code, error);
+	}
+#endif
 
 #if CONFIG_MACF
 skip_syscall:
@@ -260,6 +293,11 @@ unix_syscall_return(int error)
 #endif /* DEBUG || DEVELOPMENT */
 
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	if (__improbable(error != 0 && error != ERESTART && error != EJUSTRETURN)) {
+		n10_xpc_note(0, code, error);
+	}
+#endif
 
