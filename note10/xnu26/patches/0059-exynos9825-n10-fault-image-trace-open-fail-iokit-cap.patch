 }
+
+/*
+ * Note10 (v393): IOServiceOpen of a service that exists but returns no user
+ * client (e.g. a registry-only stub, or a class without newUserClient): one
+ * "N393O" line with the caller, service class and name, connect type and
+ * IOReturn, at most N10_OPEN_MAX lines per boot. Log only.
+ */
+#define N10_OPEN_MAX    48u
+static uint32_t n10_open_lines;
+
+static void
+n10_open_fail(IOService *service, uint32_t type, IOReturn res)
+{
+	if (__atomic_fetch_add(&n10_open_lines, 1u, __ATOMIC_RELAXED) >= N10_OPEN_MAX) {
+		return;
+	}
+	char name[MAXCOMLEN + 1];
+	proc_selfname(name, sizeof(name));
+	n10_dsslog_trace("N393O %s c=%.36s n=%.28s t=%u ret=0x%x", name,
+	    service->getMetaClass()->getClassName(), service->getName(), type, res);
+}
