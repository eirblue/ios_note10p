diff --git a/security/mac_base.c b/security/mac_base.c
index 3f45c3f..376dea3 100644
--- a/security/mac_base.c
+++ b/security/mac_base.c
@@ -1564,6 +1564,8 @@ mac_proc_check_mac_syscall(proc_t p, const char *target, int callnum)
 #define N10_MACP_MAX            48u
 extern void n10_dsslog_trace(const char *fmt, ...) __printflike(1, 2);
 static uint32_t n10_macp_lines;
+#define N10_SBX_MAX             48u
+static uint32_t n10_sbx_lines;
 #endif
 
 int
@@ -1621,6 +1623,22 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 
 done:
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	/*
+	 * Note10 (v391): libsystem_sandbox sandbox_check*() issue
+	 * __mac_syscall("Sandbox", 2, args) and return -1 on any error, which
+	 * callers read as "denied" / "sandboxed": launchd refused lookups of
+	 * sandboxed services (v390 lsd mapdb: error 159 "Sandbox restriction"),
+	 * containermanagerd's container_client_is_sandboxed() is true for every
+	 * client. No Sandbox policy is registered in this kernel, so answer the
+	 * check call as allowed: return 0 and leave the caller's result word as
+	 * userland initialised it (0). One N391K line each, cap N10_SBX_MAX.
+	 */
+	if (error == ENOPOLICY && uap->call == 2 && strcmp(target, "Sandbox") == 0) {
+		error = 0;
+		if (__atomic_fetch_add(&n10_sbx_lines, 1u, __ATOMIC_RELAXED) < N10_SBX_MAX) {
+			n10_dsslog_trace("N391K pid=%d %.16s sandbox check allowed", proc_getpid(p), p->p_comm);
+		}
+	}
 	/*
 	 * Note10 (v379): which policy/call returns ENOPOLICY (no MAC policy is
 	 * registered in this kernel). First N10_MACP_MAX lines into the dss ring
