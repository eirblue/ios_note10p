@@ -3697,8 +3697,41 @@ csops_copy_token(const void *start, size_t length, user_size_t usize, user_addr_
 /* osfmk/arm64/note10/n10_dsslog.c (v376): one bounded line into the dss log ring. */
 extern void n10_dsslog_trace(const char *fmt, ...) __printflike(1, 2);
 
-static uint32_t n10_csops_lines;
-#define N10_CSOPS_LINES 64u
+/*
+ * N390S line budget (v391; v390 used one global cap of 64 lines and launchd's
+ * early identity queries plus the ERANGE size probes spent it before
+ * backboardd's container lookup). No line for launchd (pid 1) or for an
+ * ERANGE answer (size probe; the following read logs the length). A query on
+ * another process has its own cap; a process querying itself gets at most
+ * N10_CSOPS_PER_PROC lines in one of N10_CSOPS_SLOTS per-caller slots.
+ */
+#define N10_CSOPS_SLOTS         64u
+#define N10_CSOPS_PER_PROC      4u
+#define N10_CSOPS_CROSS         64u
+static pid_t n10_csops_slot_pid[N10_CSOPS_SLOTS];
+static uint32_t n10_csops_slot_lines[N10_CSOPS_SLOTS];
+static uint32_t n10_csops_cross_lines;
+
+static bool
+n10_csops_trace_ok(pid_t caller, pid_t target, int error)
+{
+	if (caller == 1 || error == ERANGE) {
+		return false;
+	}
+	if (caller != target) {
+		return __atomic_fetch_add(&n10_csops_cross_lines, 1u, __ATOMIC_RELAXED) < N10_CSOPS_CROSS;
+	}
+	for (uint32_t i = 0; i < N10_CSOPS_SLOTS; i++) {
+		pid_t cur = 0;
+
+		if (!__atomic_compare_exchange_n(&n10_csops_slot_pid[i], &cur, caller, false,
+		    __ATOMIC_RELAXED, __ATOMIC_RELAXED) && cur != caller) {
+			continue;       /* slot owned by another pid */
+		}
+		return __atomic_fetch_add(&n10_csops_slot_lines[i], 1u, __ATOMIC_RELAXED) < N10_CSOPS_PER_PROC;
+	}
+	return false;
+}
 
