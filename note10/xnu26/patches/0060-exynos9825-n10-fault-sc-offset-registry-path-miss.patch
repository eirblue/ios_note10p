--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -305,13 +305,17 @@ n10_crash_messages(proc_t p, mach_vm_offset_t sc)
  * v392: mediaserverd died with sig 11 in a non-cache image (a dlopened
  * module under CoreAudio) whose file N383A cannot name.
  * Read-only (map lookup + vnode name), at most N10_FAULT_LINES per boot.
+ * v394: an address with no vnode-backed mapping that lies in the task's
+ * shared region is printed as "sc+0x<offset>" from the slid shared-cache
+ * start (the N383A sc= value), so cache frames resolve without the slide.
  */
 #define N10_FAULT_LINES         48u
+#define N10_SC_SPAN             0x180000000ull  /* arm64 shared region size */
 static uint32_t n10_fault_lines;
 extern struct arm_saved_state *get_user_regs(thread_t);
 
 static void
-n10_fault_where(char *buf, size_t len, uint64_t va)
+n10_fault_where(char *buf, size_t len, uint64_t va, uint64_t sc)
 {
 	struct proc_regioninfo_internal ri = { 0 };
 	uintptr_t vpa = 0;
@@ -332,13 +336,15 @@ n10_fault_where(char *buf, size_t len, uint64_t va)
 			vnode_put(vp);
 		}
 	}
-	if (name == NULL) {
+	if (name == NULL && sc != 0 && va >= sc && va - sc < N10_SC_SPAN) {
+		snprintf(buf, len, "sc+0x%llx", (unsigned long long)(va - sc));
+	} else if (name == NULL) {
 		snprintf(buf, len, "0x%llx", (unsigned long long)va);
 	}
 }
 
 static void
-n10_fault_note(proc_t p, int sig, uintptr_t pc, uintptr_t f0, uintptr_t f1)
+n10_fault_note(proc_t p, int sig, uintptr_t pc, uintptr_t f0, uintptr_t f1, uint64_t sc)
 {
 	struct uthread *ut = current_uthread();
 	char wpc[48], wlr[48], wf0[48], wf1[48];
@@ -347,10 +353,10 @@ n10_fault_note(proc_t p, int sig, uintptr_t pc, uintptr_t f0, uintptr_t f1)
 	    __atomic_fetch_add(&n10_fault_lines, 1u, __ATOMIC_RELAXED) >= N10_FAULT_LINES) {
 		return;
 	}
-	n10_fault_where(wpc, sizeof(wpc), pc);
-	n10_fault_where(wlr, sizeof(wlr), (uint64_t)get_saved_state_lr(get_user_regs(current_thread())));
-	n10_fault_where(wf0, sizeof(wf0), f0);
-	n10_fault_where(wf1, sizeof(wf1), f1);
+	n10_fault_where(wpc, sizeof(wpc), pc, sc);
+	n10_fault_where(wlr, sizeof(wlr), (uint64_t)get_saved_state_lr(get_user_regs(current_thread())), sc);
+	n10_fault_where(wf0, sizeof(wf0), f0, sc);
+	n10_fault_where(wf1, sizeof(wf1), f1, sc);
 	n10_dsslog_trace("N393M pid=%d %.16s sig=%d c=0x%llx far=0x%llx pc=%s lr=%s f0=%s f1=%s",
 	    proc_getpid(p), p->p_comm, sig, (unsigned long long)ut->uu_code,
 	    (unsigned long long)ut->uu_subcode, wpc, wlr, wf0, wf1);
@@ -389,7 +395,7 @@ n10_exit_frames(proc_t p, int sig)
 	if (sc != 0 && (sig == SIGABRT || sig == SIGTRAP || sig == SIGILL)) {
 		n10_crash_messages(p, sc);
 	}
-	n10_fault_note(p, sig, bt[0], bt[1], bt[2]);
+	n10_fault_note(p, sig, bt[0], bt[1], bt[2], (uint64_t)sc);
 }
