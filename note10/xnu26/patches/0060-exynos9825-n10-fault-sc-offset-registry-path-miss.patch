diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index ef78d7e..2900125 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -2854,6 +2854,26 @@ n10_open_fail(IOService *service, uint32_t type, IOReturn res)
 	n10_dsslog_trace("N393O %s c=%.36s n=%.28s t=%u ret=0x%x", name,
 	    service->getMetaClass()->getClassName(), service->getName(), type, res);
 }
+
+/*
+ * Note10 (v394): IORegistryEntryFromPath that finds no entry (e.g. the
+ * HAL audio plug-ins read IODeviceTree:/product/audio): one "N394P" line
+ * with the caller, the MIG variant (o = 0 inband, 1 out-of-line) and the
+ * path, at most N10_PATH_MAX lines per boot. Log only, result unchanged.
+ */
+#define N10_PATH_MAX    48u
+static uint32_t n10_path_lines;
+
+static void
+n10_path_miss(const char *path, uint32_t ool)
+{
+	if (__atomic_fetch_add(&n10_path_lines, 1u, __ATOMIC_RELAXED) >= N10_PATH_MAX) {
+		return;
+	}
+	char name[MAXCOMLEN + 1];
+	proc_selfname(name, sizeof(name));
+	n10_dsslog_trace("N394P %s o=%u p=%.100s", name, ool, path);
+}
 #endif /* ARM64_BOARD_CONFIG_EXYNOS9825 */
 
 static kern_return_t
@@ -3573,6 +3593,11 @@ is_io_registry_entry_from_path(
 		OSSafeReleaseNULL(matching);
 		OSSafeReleaseNULL(objects[1]);
 	}
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	if (!entry) {
+		n10_path_miss(path, 0);
+	}
+#endif
 
 	*registry_entry = entry;
 
@@ -3626,6 +3651,11 @@ is_io_registry_entry_from_path_ool(
