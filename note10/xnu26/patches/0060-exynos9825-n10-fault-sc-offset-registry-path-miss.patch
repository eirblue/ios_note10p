 		res = entry ? kIOReturnSuccess : kIOReturnNotFound;
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+		if (!entry) {
+			n10_path_miss(cpath, path[0] ? 0 : 1);
+		}
+#endif
 	}
 
