@@ -1614,6 +1614,10 @@ IOCurrentTaskHasEntitlement(const char *entitlement)
 	return IOTaskHasEntitlement(NULL, entitlement);
 }
 
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+extern "C" int n10_csproc_der_entitlement_bool(proc_t p, const char *entitlement);
+#endif
+
 /*
  * Reminder to reader: This only returns `true` if:
  *  - The entitlement is boolean-valued
@@ -1639,6 +1643,13 @@ IOTaskHasEntitlement(task_t task, const char *entitlement)
 		return false;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+	/* Note10: AMFI is not loaded; answer from the process's own DER entitlements. */
+	if (amfi == NULL) {
+		return n10_csproc_der_entitlement_bool(proc, entitlement) == 0;
+	}
+#endif
+
 	kern_return_t ret = amfi->OSEntitlements.queryEntitlementBooleanWithProc(
 		proc,
 		entitlement);
