+static void __attribute__((noreturn, noinline))
+n10_ufs_stop(uint32_t site, uint32_t detail)
+{
+	uint64_t code = (uint64_t)(site & 0xf) << 8 | (detail & 0xff);
+
+	__asm__ volatile (
+		"msr daifset, #0xf\n"
+		"adrp x16, _n10_ufs_stop_ladder@PAGE\n"
+		"add x16, x16, _n10_ufs_stop_ladder@PAGEOFF\n"
+		"add x16, x16, %0, lsl #2\n"
+		"br x16\n"
+		: : "r" (code) : "x16", "memory");
+	__builtin_unreachable();
