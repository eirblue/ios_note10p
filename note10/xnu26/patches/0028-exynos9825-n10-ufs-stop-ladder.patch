+/* v344 stop ladder (see header). */
+__asm__ (
+	"	.text\n"
+	"	.p2align 2\n"
+	"	.globl _n10_ufs_stop_ladder\n"
+	"_n10_ufs_stop_ladder:\n"
+	"	.rept 4096\n"
+	"	b .\n"
+	"	.endr\n");
