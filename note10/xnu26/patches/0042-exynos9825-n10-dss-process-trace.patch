diff --git a/osfmk/arm64/note10/n10_dsslog.c b/osfmk/arm64/note10/n10_dsslog.c
index 9598d73..0eaa19c 100644
--- a/osfmk/arm64/note10/n10_dsslog.c
+++ b/osfmk/arm64/note10/n10_dsslog.c
@@ -52,6 +52,9 @@
  * No printf, panic, lock, allocation or system-register write on that path.
  */
 #if defined(ARM64_BOARD_CONFIG_EXYNOS9825)
+#include <sys/cdefs.h>
+#include <stdarg.h>
+#include <stddef.h>
 #include <stdint.h>
 #include <mach/vm_types.h>
 #include <mach/vm_param.h>
@@ -207,6 +210,43 @@ n10_dsslog_putc(char c)
 	n10_dsslog_write(&c, 1);
 }
 
+/*
+ * v376: one bounded diagnostic line (exec/exit/spawn/reboot) formatted into a
+ * stack buffer and appended with a single n10_dsslog_write call, so it is not
+ * split by other console text. No allocation, no lock; vsnprintf only formats.
+ * At most N10_TRACE_MAX lines per boot (~120 KiB), so the ring keeps room for
+ * later console and panic text.
+ */
+#define N10_TRACE_MAX           768u
+#define N10_TRACE_TEXT          160u
+extern int vsnprintf(char *, size_t, const char *, va_list) __printflike(3, 0);
+void n10_dsslog_trace(const char *fmt, ...) __printflike(1, 2);
+static uint32_t n10_trace_lines;
+
+void
+n10_dsslog_trace(const char *fmt, ...)
+{
+	char text[N10_TRACE_TEXT];
+	va_list args;
+	int n;
+
+	if (n10_dss_state == N10_DSS_OFF ||
+	    __atomic_fetch_add(&n10_trace_lines, 1u, __ATOMIC_RELAXED) >= N10_TRACE_MAX) {
+		return;
+	}
+	va_start(args, fmt);
+	n = vsnprintf(text, sizeof(text) - 1, fmt, args);
+	va_end(args);
+	if (n < 0) {
+		return;
+	}
+	if (n > (int)sizeof(text) - 2) {
+		n = (int)sizeof(text) - 2;
+	}
+	text[n++] = '\n';
+	n10_dsslog_write(text, n);
+}
