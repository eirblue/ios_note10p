diff --git a/osfmk/arm64/note10/n10_wdt.c b/osfmk/arm64/note10/n10_wdt.c
index b9cfcb6..bd9d1af 100644
--- a/osfmk/arm64/note10/n10_wdt.c
+++ b/osfmk/arm64/note10/n10_wdt.c
@@ -39,6 +39,10 @@
 #include <kern/timer_call.h>
 #include <pexpert/pexpert.h>
 #include <pexpert/device_tree.h>
+#include <arm/cpu_data.h>
+#include <arm/cpu_data_internal.h>
+#include <arm64/proc_reg.h>
+#include <kern/misc_protos.h>
 
 #define N10_WTCON               0x0
 #define N10_WTDAT               0x4
@@ -57,6 +61,47 @@ static uint64_t n10_wdt_period_abs, n10_wdt_deadline_abs;
 static bool n10_wdt_stopped, n10_wdt_running;
 uint32_t n10_wdt_ticks;         /* timer-path pets (exported for n10_ufs) */
 void n10_wdt_kick(void);
+static uint64_t n10_wdt_start_abs;
+
+/*
+ * v376: one "N376H" line per timer-path pet into the dss ring
+ * (osfmk/arm64/note10/n10_dsslog.c), so the last line before a reset shows
+ * when XNU last ran its timer interrupt, the free page count, the number of
+ * threads waiting for a free page and the interrupted PC (el0=1: user).
+ * One "N376W" line when petting stops. At most one H line per 2 s, bounded
+ * by the deadline (<= 450). No lock, no allocation: snprintf only formats
+ * into the stack buffer and n10_dsslog_write masks DAIF itself.
+ */
+extern void n10_dsslog_write(const char *s, int n);
+extern unsigned int vm_page_free_count;
+extern unsigned int vm_page_free_wanted;
+
+static void
+n10_wdt_note(uint64_t now, const char *stop)
+{
+	char line[128];
+	uint64_t ns = 0, pc = 0;
+	unsigned int el0 = 0;
+	int n;
+
+	absolutetime_to_nanoseconds(now - n10_wdt_start_abs, &ns);
+	if (stop != NULL) {
+		n = snprintf(line, sizeof(line), "N376W stop t=%llu.%03llu %s\n",
+		    ns / NSEC_PER_SEC, (ns % NSEC_PER_SEC) / NSEC_PER_MSEC, stop);
+	} else {
+		arm_saved_state_t *ss = (arm_saved_state_t *)getCpuDatap()->cpu_int_state;
+		if (ss != NULL) {
+			pc = get_saved_state_pc(ss);
+			el0 = PSR64_IS_USER(get_saved_state_cpsr(ss)) ? 1u : 0u;
+		}
+		n = snprintf(line, sizeof(line), "N376H t=%llu.%03llu free=%u want=%u el0=%u pc=0x%llx\n",
+		    ns / NSEC_PER_SEC, (ns % NSEC_PER_SEC) / NSEC_PER_MSEC,
+		    vm_page_free_count, vm_page_free_wanted, el0, pc);
+	}
+	if (n > 0) {
+		n10_dsslog_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+	}
+}
 
