+/* Existing u32 value of a property of e, -1 when absent or not 4 bytes. */
+static int64_t
+n10_dt_u32(IORegistryEntry *e, const char *key)
+{
+	OSData *d = OSDynamicCast(OSData, e->getProperty(key));
+	uint32_t v = 0;
+
+	if (d == NULL || d->getLength() != sizeof(v)) {
+		return -1;
+	}
+	memcpy(&v, d->getBytesNoCopy(), sizeof(v));
+	return v;
+}
+
+/*
+ * v397: /chosen display-scale 3 when absent or 0, display-rotation 0 when
+ * absent (MobileGestalt main-screen-scale / orientation; see the header).
+ */
+static void
+n10_chosen_publish(void)
+{
+	static const uint32_t scale = 3u, rotation = 0u;
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	int64_t was_scale = -1, was_rotation = -1;
+	unsigned int added = 0;
+	int found = chosen != NULL ? 1 : 0;
+
+	if (chosen != NULL) {
+		was_scale = n10_dt_u32(chosen, "display-scale");
+		was_rotation = n10_dt_u32(chosen, "display-rotation");
+		if (was_scale <= 0) {
+			OSData *d = OSData::withBytes(&scale, sizeof(scale));
+			if (d != NULL) {
+				added |= chosen->setProperty("display-scale", d) ? 1u : 0u;
+				d->release();
+			}
+		}
+		if (chosen->getProperty("display-rotation") == NULL) {
+			OSData *d = OSData::withBytes(&rotation, sizeof(rotation));
+			if (d != NULL) {
+				added |= chosen->setProperty("display-rotation", d) ? 2u : 0u;
+				d->release();
+			}
+		}
+		chosen->release();
+	}
+	n10_dsslog_trace("N397D chosen=%d scale_was=%lld rotation_was=%lld added=0x%x", found,
+	    (long long)was_scale, (long long)was_rotation, added);
+}
