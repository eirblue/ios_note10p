+/*
+ * v410: where is the receive right of a send right n10_port_peer could not resolve (bsd/dev/arm/systemcalls.c N410P,
+ * SpringBoard / lsd / containermanagerd send-only mach_msg2, thread context, before the trap runs)? Returns the
+ * ipc_port_translate_send kr when the name is not a send right (dead name, send-once, invalid); else 0 with the port's
+ * io_state, its queued message count and, when the port is in transit (inside a message, incl. a port-destroyed
+ * notification), the receiving task of the port whose queue holds that message (one hop: the held port keeps a
+ * reference on it; it is only try-locked under the held port lock, never waited for; -3 busy, -2 itself not in a
+ * space). Read only: no right, reference or port state changes.
+ */
+int n10_port_where(uint32_t name, uint32_t *st, uint32_t *qn, int *dpid, char *dcomm, int len);
+
+int
+n10_port_where(uint32_t name, uint32_t *st, uint32_t *qn, int *dpid, char *dcomm, int len)
+{
+	ipc_port_t port = IP_NULL, dest;
+	ipc_space_t space;
+	task_t task;
+	void *bp;
+	const char *nm = NULL;
+	kern_return_t kr;
+	int k = 0;
+
+	if (st == NULL || qn == NULL || dpid == NULL || dcomm == NULL || len <= 1) {
+		return -1;
+	}
+	*st = 0xffu;
+	*qn = 0;
+	*dpid = -1;
+	dcomm[0] = '\0';
+	if (name == 0) {
+		return -1;
+	}
+	kr = ipc_port_translate_send(current_space(), (mach_port_name_t)name, &port);
+	if (kr != KERN_SUCCESS) {
+		return (int)kr;
+	}
+	*st = (uint32_t)ip_to_object(port)->io_state;
+	*qn = port->ip_messages.imq_msgcount;
+	dest = ip_in_transit(port) ? ip_get_destination(port) : IP_NULL;
+	if (dest != IP_NULL && ip_mq_lock_try(dest)) {
+		space = ip_get_receiver(dest);
+		if (space != NULL) {
+			task = space->is_task;
+			bp = task != TASK_NULL ? get_bsdtask_info(task) : NULL;
+			nm = bp != NULL ? proc_name_address(bp) : NULL;
+			*dpid = task != TASK_NULL ? task_pid(task) : -1;
+		} else {
+			*dpid = -2;
+		}
+		for (; nm != NULL && k < len - 1 && nm[k] != '\0'; k++) {
+			dcomm[k] = nm[k];
+		}
+		ip_mq_unlock(dest);
+	} else if (dest != IP_NULL) {
+		*dpid = -3;
+	}
+	dcomm[k] = '\0';
+	ip_mq_unlock(port);
+	return 0;
+}
 #endif
 
